---
import { render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CarveOutDisclaimer from '@/components/ui/CarveOutDisclaimer.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { nearbyAreasHtml, site } from '@/data/site';
import { locationDetails } from '@/data/locationDetails';
import { hasCityPages } from '@/data/cityServices';
import CityCards from '@/components/services/CityCards.astro';

const { entry, all, city } = Astro.props as { entry: any; all: any[]; city?: 'rockville' | 'frederick' };
const cityName = city ? site.locations.find((l) => l.slug === city)!.city : '';
const cityDetail = city ? locationDetails[city] : undefined;
const d = entry.data;
const { Content } = await render(entry);
const rich = Boolean(d.lead);
const related = d.related.map((id) => all.find((x) => x.id === id)).filter(Boolean);
const hash = [...entry.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const pick = <T,>(arr: T[], k: number) => arr[(hash + k) % arr.length];
const landscape = ['/images/about/exam-senior.jpg','/images/about/examine-back.jpg','/images/about/movement.jpg','/images/about/team-smile.jpg','/images/interventional/spine-injection.jpg','/images/sections/about.jpg','/images/sections/virtual-visit.jpg','/images/about/team-tablet.jpg'];
const portrait = ['/images/tunnel/clinic-2.jpg','/images/tunnel/clinic-3.jpg','/images/tunnel/clinic-4.jpg','/images/tunnel/consult-senior.jpg','/images/tunnel/diagnosis.jpg','/images/tunnel/doctor-patient.jpg','/images/tunnel/physio-spine.jpg','/images/tunnel/spine-anatomy.jpg','/images/tunnel/spine-model.jpg'];
const wide = ['/images/sections/parallax.jpg','/images/sections/mission.jpg','/images/hero/hero-2.jpg','/images/hero/hero-3.jpg','/images/hero/hero-4.jpg'];
const basicsImg = d.basicsImage ?? pick(landscape, 0);
const condImg = d.conditionsImage ?? pick(portrait, 1);
const stepsImg = d.stepsImage ?? pick(portrait, 4);
const reliefImg = d.reliefImage ?? pick(wide, 2);
const gal = d.gallery.length >= 3 ? d.gallery : [pick(landscape, 3), pick(landscape, 5), pick(landscape, 7)];
const heroTitle = city ? `${d.title}${d.carveOut ? ' *' : ''} in ${cityName}, MD.` : `${d.title}${d.carveOut ? ' *' : ''}`;
const hl = city ? [cityName] : [];
const nearbyHtml = cityDetail ? cityDetail.nearby : nearbyAreasHtml;
const crumbs = city ? [{ label: 'Services', href: '/services' }, { label: d.title, href: `/services/${entry.id}` }, { label: cityName }] : undefined;
const metaDesc = city ? `${d.title} in ${cityName}, Maryland. ${d.summary}` : d.summary;
const ctaTitle = `Ready to talk about ${d.title.replace(/ Procedure$/, '')}${city ? ' in ' + cityName : ''}?`;
---

{rich ? (
  <PageLayout title={heroTitle} crumb={d.title} crumbs={crumbs} highlight={hl} eyebrow="Service" lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} description={metaDesc} nearby={nearbyHtml}>
    <section class="section overflow-hidden pb-28 lg:pb-36">
      <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-6" data-reveal>
          <p class="eyebrow">The basics</p>
          <h2 class="h2 mt-4">What is {d.title.replace(/ Procedure$/, '')}?</h2>
          <div class="rule-gold mt-6"></div>
          <div class="prose-lux mt-6 space-y-4 text-lg leading-relaxed text-charcoal-600 [&_strong]:text-charcoal-950"><Content /></div>
        </div>
        <div class="relative lg:col-span-6" data-reveal style="--d:120ms">
          <div class="absolute -right-4 -top-4 hidden h-full w-full rounded-md border border-gold-400/50 lg:block" aria-hidden="true"></div>
          <div class="relative aspect-[5/4] overflow-hidden rounded-md bg-charcoal-800 shadow-[0_40px_70px_-40px_rgba(0,0,0,.6)]">
            <img src={basicsImg} alt="" width="1200" height="960" loading="lazy" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/40 via-transparent to-transparent"></div>
          </div>
          {d.facts.length > 0 && (
            <dl class="relative z-10 mt-6 rounded-md border border-gold-400/60 bg-cream-50/95 p-7 shadow-[0_30px_60px_-30px_rgba(40,30,0,.5)] backdrop-blur lg:absolute lg:-bottom-16 lg:-left-14 lg:mt-0 lg:w-[20rem]">
              <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent" aria-hidden="true"></span>
              <p class="eyebrow mb-5">At a glance</p>
              {d.facts.map((f, i) => (
                <div class={i > 0 ? 'mt-4 border-t border-charcoal-900/10 pt-4' : ''}>
                  <dt class="font-display text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold-700">{f.k}</dt>
                  <dd class="mt-1 font-display text-lg font-semibold leading-snug text-charcoal-950">{f.v}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>

    {d.conditions.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-reveal>
            <div class="absolute -bottom-4 -left-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
            <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800">
              <img src={condImg} alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-charcoal-950/80 to-transparent p-6 pt-20"><p class="font-display text-lg font-semibold text-cream-50">Care that fits your pain.</p></div>
            </div>
          </div>
          <div class="lg:col-span-7" data-reveal style="--d:100ms">
            <p class="eyebrow">Who it helps</p>
            <h2 class="h2 mt-4">{d.conditionsTitle}</h2>
            <div class="rule-gold mt-6"></div>
            <ul class="mt-8 space-y-3">
              {d.conditions.map((c, i) => (
                <li class="group flex items-center gap-4 rounded-md border border-charcoal-900/10 bg-cream-50 px-5 py-4 text-lg text-charcoal-800 transition duration-500 ease-[var(--ease-lux)] hover:translate-x-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_18px_36px_-24px_rgba(95,76,0,.5)]">
                  <Check /><span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {d.steps.length > 0 && (
      <section class="section">
        <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow">Step by step</p>
            <h2 class="h2 mt-4 max-w-xl">{d.stepsTitle}</h2>
            <ol class="relative mt-12 space-y-9 before:absolute before:bottom-3 before:left-[1.4rem] before:top-3 before:w-px before:bg-gradient-to-b before:from-gold-400 before:via-gold-400/40 before:to-transparent">
              {d.steps.map((s, i) => (
                <li class="relative flex gap-6">
                  <span class="relative z-10 grid h-11 w-11 shrink-0 place-items-center rounded-full border border-gold-400 bg-charcoal-950 font-display text-sm font-semibold text-gold-300 shadow-[0_0_0_6px_var(--color-cream-50)]">{String(i + 1).padStart(2, '0')}</span>
                  <div class="pt-1">
                    <h3 class="font-display text-xl font-semibold text-charcoal-950">{s.t}</h3>
                    <p class="mt-2 text-lg leading-relaxed text-charcoal-600">{s.d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="lg:col-span-5" data-reveal style="--d:120ms">
            <div class="relative mx-auto max-w-md lg:sticky lg:top-32 lg:max-w-none">
              <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
              <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800">
                <img src={stepsImg} alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" />
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="pb-2" aria-hidden="true">
      <div class="container-x grid h-auto gap-4 sm:h-[30rem] sm:grid-cols-3 sm:grid-rows-2" data-reveal>
        <div class="h-64 overflow-hidden rounded-md sm:row-span-2 sm:h-auto"><img src={gal[0]} alt="" loading="lazy" width="900" height="900" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] hover:scale-105" /></div>
        <div class="h-56 overflow-hidden rounded-md sm:col-span-2 sm:h-auto"><img src={gal[1]} alt="" loading="lazy" width="1200" height="600" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] hover:scale-105" /></div>
        <div class="relative h-56 overflow-hidden rounded-md bg-charcoal-950 sm:col-span-2 sm:h-auto">
          <img src={gal[2]} alt="" loading="lazy" width="1200" height="600" class="h-full w-full object-cover opacity-70" />
          <div class="absolute inset-0 flex items-end bg-gradient-to-t from-charcoal-950/85 to-transparent p-7"><p class="max-w-md font-display text-xl font-semibold leading-snug text-cream-50">Board-certified care, close to home in Rockville and Frederick.</p></div>
        </div>
      </div>
    </section>

    {d.cards.length > 0 && (
      <section class="section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">{d.cardsEyebrow}</p>
            <h2 class="h2 mt-4">{d.cardsTitle}</h2>
          </div>
          <ul class="mt-14 grid gap-6 sm:grid-cols-2">
            {d.cards.map((c, i) => (
              <li data-reveal style={`--d:${(i % 2) * 90}ms`} class="group relative overflow-hidden rounded-md border border-charcoal-900/10 bg-gradient-to-br from-white to-cream-100 p-8 pt-10 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:shadow-[0_26px_46px_-26px_rgba(95,76,0,.5)]">
                <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-[.18] bg-gold-400 transition-transform duration-700 ease-[var(--ease-lux)] group-hover:scale-x-100" aria-hidden="true"></span>
                <span class="pointer-events-none absolute -right-2 -top-4 font-display text-8xl font-bold text-charcoal-900/[.04]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="relative font-display text-xl font-semibold">{c.t}</h3>
                <p class="relative mt-3 text-lg leading-relaxed text-charcoal-600">{c.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.relief && (
      <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24 lg:py-32">
        <img src={reliefImg} alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-35" />
        <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/85 to-charcoal-950/40" aria-hidden="true"></div>
        <div class="container-x relative grid items-center gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow">Recovery</p>
            <h2 class="mt-4 font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">{d.reliefTitle}</h2>
            <div class="rule-gold mt-6"></div>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream-200">{d.relief}</p>
          </div>
          {d.facts.length > 0 && (
            <div class="lg:col-span-5" data-reveal style="--d:120ms">
              <ul class="space-y-3">
                {d.facts.map((f) => (
                  <li class="rounded-md border border-white/15 bg-white/[.07] px-6 py-5 backdrop-blur-sm">
                    <p class="font-display text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold-300">{f.k}</p>
                    <p class="mt-1 font-display text-xl font-semibold text-cream-50">{f.v}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {(d.goodFit.length > 0 || d.risks.length > 0) && (
      <section class="bg-cream-100 section">
        <div class="container-x grid gap-8 lg:grid-cols-2">
          {d.goodFit.length > 0 && (
            <div class={'overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 ' + (d.risks.length === 0 ? 'lg:col-span-2 lg:grid lg:grid-cols-2' : '')} data-reveal>
              <div class={'relative bg-charcoal-900 ' + (d.risks.length === 0 ? 'h-56 lg:order-2 lg:h-auto' : 'h-44')}><img src={pick(landscape, 6)} alt="" loading="lazy" width="1000" height="400" class="h-full w-full object-cover opacity-90" /><div class={'absolute inset-0 bg-gradient-to-t from-cream-50 to-transparent ' + (d.risks.length === 0 ? 'lg:hidden' : '')}></div></div>
              <div class={'p-8 pt-2 sm:p-10 sm:pt-2 ' + (d.risks.length === 0 ? 'lg:p-12' : '')}>
                <p class="eyebrow">Candidates</p>
                <h2 class="mt-3 font-display text-2xl font-semibold">{d.fitTitle}</h2>
                <ul class="mt-6 space-y-3 text-charcoal-800">
                  {d.goodFit.map((g) => <li class="flex gap-3"><Check /><span>{g}</span></li>)}
                </ul>
                {d.notFit.length > 0 && (
                  <>
                    <h3 class="mt-8 font-display text-base font-semibold">{d.notFitTitle}</h3>
                    <ul class="mt-4 space-y-3 text-charcoal-600">
                      {d.notFit.map((g) => <li class="flex gap-3"><Check tone="no" /><span>{g}</span></li>)}
                    </ul>
                  </>
                )}
                <p class="mt-6 text-sm text-charcoal-600">Your physician makes the final decision after an exam.</p>
              </div>
            </div>
          )}
          {d.risks.length > 0 && (
            <div class={'rounded-md border border-gold-400/50 bg-gradient-to-br from-white via-cream-50 to-cream-100 p-8 shadow-[0_30px_60px_-40px_rgba(95,76,0,.45)] sm:p-10 ' + (d.goodFit.length === 0 ? 'mx-auto w-full max-w-3xl lg:col-span-2' : '')} data-reveal style="--d:100ms">
              <p class="eyebrow">Safety</p>
              <h2 class="mt-3 font-display text-2xl font-semibold">{d.risksTitle}</h2>
              {d.risksIntro && <p class="mt-3 text-charcoal-600">{d.risksIntro}</p>}
              <ul class="mt-6 space-y-4 text-lg text-charcoal-800">
                {d.risks.map((r) => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span><span>{r}</span></li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {(d.alternatives.length > 0 || d.notice) && (
      <section class="section">
        <div class="container-x">
          <div class="mx-auto max-w-3xl space-y-8">
            {d.alternatives.length > 0 && (
              <div data-reveal>
                <p class="eyebrow">Other options</p>
                <h2 class="mt-3 font-display text-2xl font-semibold">Other ways to treat the pain</h2>
                <ul class="mt-5 flex flex-wrap gap-2.5">
                  {d.alternatives.map((a) => <li class="rounded-md border border-charcoal-900/15 bg-cream-50 px-4 py-2 text-sm text-charcoal-800">{a}</li>)}
                </ul>
              </div>
            )}
            {d.notice && (
              <div class="rounded-md border border-charcoal-900/10 bg-cream-50 p-6 text-charcoal-600" data-reveal><p>{d.notice}</p></div>
            )}
          </div>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Keep exploring</p>
            <h2 class="h2 mt-4">Related treatments.</h2>
          </div>
          <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li data-reveal>
                <a href={`/services/${r!.id}`} class="group block h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white">
                  {r!.data.heroImage && <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={r!.data.heroImage} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" /></div>}
                  <div class="p-6">
                    <h3 class="font-display text-lg font-semibold">{r!.data.title}</h3>
                    <p class="mt-2 text-charcoal-600">{r!.data.summary}</p>
                    <span class="link-arrow mt-4 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {hasCityPages(entry.id) && <CityCards serviceId={entry.id} serviceTitle={d.title} current={city} />}
    <OfficesSection city={city} serviceTitle={d.title} />
    {d.carveOut && <div class="container-x"><CarveOutDisclaimer /></div>}
    <CtaBand slot="after" title={ctaTitle} />
  </PageLayout>
) : (
  <PageLayout title={heroTitle} crumb={d.title} crumbs={crumbs} highlight={hl} eyebrow="Service" description={metaDesc} nearby={nearbyHtml}>
    <section class="section">
      <div class="container-x">
        <div class="max-w-3xl space-y-4 text-lg leading-relaxed text-charcoal-600"><Content /></div>
        <a href={FIND_A_DOCTOR_URL} class="btn btn-dark mt-10">See My Provider</a>
        {d.carveOut && <CarveOutDisclaimer />}
      </div>
    </section>
    <OfficesSection tint city={city} serviceTitle={d.title} />
  </PageLayout>
)}

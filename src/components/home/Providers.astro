---
import { getCollection } from 'astro:content';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
const docs = (await getCollection('doctors')).sort((a, b) => a.data.order - b.data.order);
const initials = (n: string) => n.replace(/,.*$/, '').split(' ').filter((w) => !/^dr\.?$/i.test(w)).map((w) => w[0]).slice(0, 2).join('');
---

<section id="providers" class="relative overflow-hidden bg-gradient-to-b from-cream-50 via-white to-cream-100 section">
  <div class="pointer-events-none absolute -left-24 top-24 h-80 w-80 rounded-full bg-cream-200/70 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 bottom-10 h-96 w-96 rounded-full bg-cream-200/70 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Our providers</p>
      <h2 class="h2 mt-4">Choose your provider.</h2>
      <div class="rule-gold mx-auto mt-6"></div>
      <p class="lead mt-6">Meet the physicians who will guide your care, and schedule online when you are ready.</p>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-x-10 gap-y-14 sm:grid-cols-2">
      {docs.map((d, i) => (
        <article data-reveal style={`--d:${i * 120}ms`} class="group relative">
          <!-- offset yellow frame that slides on hover -->
          <span class="pointer-events-none absolute inset-0 translate-x-3 translate-y-3 rounded-md border border-gold-400/50 transition duration-500 ease-[var(--ease-lux)] group-hover:translate-x-5 group-hover:translate-y-5 group-hover:bg-cream-200/50" aria-hidden="true"></span>

          <div class="relative overflow-hidden rounded-md bg-white shadow-[0_24px_50px_-30px_rgba(27,28,31,0.5)] transition duration-500 ease-[var(--ease-lux)] group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:shadow-[0_36px_60px_-30px_rgba(95,76,0,0.55)]">
            <a href={`/doctors/${d.id}`} class="relative block aspect-square overflow-hidden bg-gradient-to-br from-cream-200 to-cream-100" aria-label={`${d.data.name}, view profile`}>
              <span class="absolute inset-0 flex items-center justify-center font-display text-6xl font-semibold text-gold-600/50" aria-hidden="true">{initials(d.data.name)}</span>
              <img src={d.data.photo ?? `/images/providers/${d.id}.jpg`} alt={d.data.name} width="800" height="800" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" onerror="this.remove()" />
              <span class="absolute inset-0 bg-gradient-to-t from-charcoal-950/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
              <span class="absolute left-4 top-4 rounded-md bg-charcoal-950/75 px-3 py-1.5 font-display text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-cream-50 backdrop-blur">Board certified</span>
              <span class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-between px-5 py-4 text-cream-50 transition-transform duration-500 ease-[var(--ease-lux)] group-hover:translate-y-0 group-focus-within:translate-y-0">
                <span class="font-display text-[0.75rem] font-semibold uppercase tracking-[0.16em]">View profile</span>
                <svg class="transition-transform duration-500 group-hover:translate-x-1.5" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" /></svg>
              </span>
            </a>

            <div class="relative p-6 sm:p-7">
              <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-gold-400 transition-transform duration-700 ease-[var(--ease-lux)] group-hover:scale-x-100" aria-hidden="true"></span>
              <h3 class="font-display text-[1.375rem] font-semibold">{d.data.name}</h3>
              <p class="mt-1 text-sm text-charcoal-600">{d.data.title}</p>
              <div class="my-5 h-px w-10 bg-gold-400 transition-all duration-500 group-hover:w-24"></div>
              <div class="flex flex-wrap items-center gap-3">
                <a href={FIND_A_DOCTOR_URL} class="btn btn-dark !min-h-10 !px-5">Schedule online</a>
                <a href={`/doctors/${d.id}`} class="link-arrow text-gold-700">View profile</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

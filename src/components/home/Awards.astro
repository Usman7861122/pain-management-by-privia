---
import fs from 'node:fs';
import { awards, hospitalPrivileges } from '@/data/awards';

const logoFor = (id: string) => {
  for (const ext of ['svg', 'png', 'webp']) {
    const p = `/images/awards/${id}.${ext}`;
    if (fs.existsSync(`${process.cwd()}/public${p}`)) return p;
  }
  return null;
};
const items = awards.map((a: any) => ({ ...a, logo: logoFor(a.id) }));
---

<section id="awards" class="relative overflow-hidden bg-cream-100 section">
  <div class="pointer-events-none absolute -top-32 left-1/2 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-cream-200/70 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Awards &amp; recognition</p>
      <h2 class="h2 mt-4">Trusted by patients. Recognized by peers.</h2>
      <div class="rule-gold mx-auto mt-6"></div>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((a, i) => (
        <li data-reveal style={`--d:${i * 80}ms`} class="award group relative rounded-md border border-gold-400/60 p-1.5 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-600 hover:shadow-[0_24px_50px_-24px_rgba(27,28,31,0.45)]">
          <div class="relative flex h-full flex-col items-center overflow-hidden rounded-sm border border-gold-400/30 bg-cream-50 px-6 py-9 text-center transition-colors duration-500 group-hover:bg-gradient-to-b group-hover:from-white group-hover:to-cream-100">
            <span class="pointer-events-none absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gold-400 transition-transform duration-500 ease-[var(--ease-lux)] group-hover:scale-x-100"></span>
            <div class="flex h-24 w-full items-center justify-center">
              {a.logo ? (
                <div class="flex h-20 w-full items-center justify-center rounded-md bg-white px-5 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.05)]"><img src={a.logo} alt={`${a.by} logo`} loading="lazy" class="max-h-12 w-auto max-w-full object-contain grayscale transition duration-500 group-hover:grayscale-0" /></div>
              ) : (
                <div class="relative grid h-24 w-24 place-items-center rounded-full border border-gold-400/70 text-gold-600 transition duration-500 group-hover:border-gold-600 group-hover:bg-cream-200/70">
                  <span class="absolute inset-1.5 rounded-full border border-dashed border-gold-400/50"></span>
                  <svg width="36" height="36" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                    <circle cx="22" cy="19" r="11" /><path d="M16 28l-3 11 9-4 9 4-3-11" /><path d="M22 13l1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z" />
                  </svg>
                </div>
              )}
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug transition-colors duration-500">{a.title}</h3>
            <div class="my-3 h-px w-8 bg-gold-400 transition-all duration-500 group-hover:w-16"></div>
            <p class="text-sm text-charcoal-600 transition-colors duration-500">{a.by}{a.year && ` · ${a.year}`}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-14 text-center" data-reveal>
      <p class="eyebrow mb-4">Hospital privileges</p>
      <ul class="flex flex-wrap justify-center gap-3">
        {hospitalPrivileges.map((h) => (
          <li class="rounded-md border border-gold-400/50 bg-cream-50 px-5 py-3 text-sm text-charcoal-800 transition duration-300 hover:border-gold-600 hover:bg-cream-200">{h}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

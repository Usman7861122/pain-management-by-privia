---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import { nearbyAreasHtml } from '@/data/site';
import { conditionGroups } from '@/data/conditionGroups';

const { group: gid } = Astro.props;
const g = conditionGroups.find((x) => x.id === gid)!;
const all = await getCollection('conditions');
const items = g.ids.map((id) => all.find((x) => x.id === id)!).filter(Boolean);
const img = (e: any) => e.data.heroImage || e.data.image || `/images/conditions/${e.id}.jpg`;
const others = conditionGroups.filter((x) => x.id !== g.id);
---

<PageLayout title={`${g.title} Conditions in Rockville and Frederick, MD.`} crumb={g.title} crumbs={[{ label: 'Conditions', href: '/conditions' }]} highlight={['Rockville', 'Frederick']} eyebrow="Conditions" lead={g.lead} image={g.image} imageAlt={g.heroAlt} description={`${g.title} pain conditions treated at Pain Management Specialists in Rockville and Frederick, Maryland.`} nearby={nearbyAreasHtml}>
  <section class="section overflow-hidden">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Start here</p>
        <h2 class="h2 mt-4">{g.text.replace(/\.$/, '')}: the conditions we treat.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Pick a condition to see its symptoms, causes and the treatments we use. Not sure which one fits you? Book a visit and our physicians will find the cause.</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 text-lg text-charcoal-800">
          {items.map((e) => <li class="flex gap-3"><Check /><a href={`/conditions/${e.id}`} class="underline-offset-4 hover:underline">{e.data.title}</a></li>)}
        </ul>
      </div>
      <div class="relative lg:col-span-5" data-reveal style="--d:120ms">
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800"><img src="/images/tunnel/doctor-patient.jpg" alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Conditions</p>
        <h2 class="h2 mt-4">Find your condition.</h2>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((e, i) => (
          <li data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <a href={`/conditions/${e.id}`} class="group flex h-full flex-col overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
              <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={img(e)} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.07]" /></div>
              <div class="flex flex-1 flex-col p-7">
                <h3 class="font-display text-xl font-semibold">{e.data.title}</h3>
                <p class="mt-3 flex-1 text-charcoal-600">{e.data.summary}</p>
                <span class="link-arrow mt-5 text-gold-700">Learn more</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24">
    <img src="/images/sections/parallax.jpg" alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/85 to-charcoal-950/40" aria-hidden="true"></div>
    <div class="container-x relative" data-reveal>
      <p class="eyebrow">Also see</p>
      <h2 class="mt-4 font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">Other conditions we treat.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {others.map((o) => (
          <a href={`/conditions/${o.slug}`} class="group rounded-md border border-white/15 bg-white/[.07] p-7 backdrop-blur-sm transition hover:border-gold-400/70 hover:bg-white/10">
            <p class="font-display text-xl font-semibold text-cream-50">{o.title}</p>
            <p class="mt-2 text-cream-200">{o.text}</p>
            <span class="link-arrow mt-4 text-gold-300">View conditions</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <OfficesSection />
  <CtaBand slot="after" title="Living with pain?" text="You do not have to manage it alone. Choose your provider and schedule online, or call our team." />
</PageLayout>

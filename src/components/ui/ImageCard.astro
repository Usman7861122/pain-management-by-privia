---
interface Props {
  href: string;
  title: string;
  summary: string;
  image?: string;
  carveOut?: boolean;
  class?: string;
  ctaLabel?: string;
}
const { href, title, summary, image, carveOut = false, class: cls = '', ctaLabel = 'Read more' } = Astro.props;
---

<a href={href} class:list={['reveal-card group relative isolate flex min-h-[22rem] overflow-hidden rounded-md bg-charcoal-900 text-cream-50 lg:min-h-[26rem]', cls]}>
  <div class="absolute inset-0 -z-20 bg-gradient-to-br from-charcoal-800 via-charcoal-900 to-charcoal-950" aria-hidden="true"></div>
  {image && (
    <img src={image} alt="" loading="lazy" width="800" height="1000"
      class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]"
      onerror="this.remove()" />
  )}
  <div class="absolute inset-0 -z-[5] bg-gradient-to-t from-charcoal-950/90 via-charcoal-950/35 to-charcoal-950/5" aria-hidden="true"></div>

  <div class="mt-auto w-full p-6 lg:p-7">
    <h3 class="font-display text-[1.2rem] font-semibold leading-snug !text-cream-50">{title}{carveOut && <span aria-label="carve-out service"> *</span>}</h3>
    <div class="reveal-body grid transition-all duration-500 ease-[var(--ease-lux)]">
      <div class="overflow-hidden">
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-cream-200">{summary}</p>
        <span class="link-arrow mt-2 text-gold-300">{ctaLabel}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" /></svg>
        </span>
      </div>
    </div>
    <span class="mt-4 block h-px w-10 bg-gold-400 transition-all duration-500 group-hover:w-20" aria-hidden="true"></span>
  </div>
</a>

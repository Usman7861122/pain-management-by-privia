---
// Clickable breadcrumbs. Built from the URL, so every page gets them automatically.
// Override per page with PageLayout props: crumb (last label) and crumbs (parent trail).
interface Crumb { label: string; href?: string }
interface Props { title: string; crumb?: string; crumbs?: Crumb[] }
const { title, crumb, crumbs } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pagesThatExist = new Set(['/about', '/services', '/conditions', '/doctors', '/blog', '/locations', '/resources', '/contact']);
const segLabel: Record<string, string> = { about: 'About Us', services: 'Services', conditions: 'Conditions', doctors: 'Our Team', blog: 'Blog', 'patient-resources': 'Patient Resources', locations: 'Locations', resources: 'Patient Forms' };
const pageLabel: Record<string, string> = { '/about': 'About Us', '/doctors': 'Our Team', '/about/what-we-do': 'What We Do', '/about/treatment-without-opioids': 'Treatment Without Opioids', '/about/about-privia': 'About Privia', '/patient-resources/faq': 'FAQ', '/patient-resources/covid-19': 'COVID-19', '/patient-resources/returning-patients': 'Returning Patients' };

const segs = path.split('/').filter(Boolean);
const trail: Crumb[] = [{ label: 'Home', href: '/' }];
if (crumbs) {
  trail.push(...crumbs);
} else {
  if (segs[0] === 'doctors') trail.push({ label: 'About Us', href: '/about' });
  let acc = '';
  for (const s of segs.slice(0, -1)) {
    acc += '/' + s;
    trail.push({ label: segLabel[s] ?? s, href: pagesThatExist.has(acc) ? acc : undefined });
  }
}
const last = crumb ?? pageLabel[path] ?? title.replace(/\.$/, '');
trail.push({ label: last });

const origin = Astro.url.origin;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: origin + c.href } : {}) })),
};
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-y-1 font-display text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-cream-200">
    {trail.map((c, i) => (
      <li class="flex items-center">
        {i > 0 && <span class="mx-2 opacity-50" aria-hidden="true">/</span>}
        {c.href && i < trail.length - 1
          ? <a href={c.href} class="underline-offset-4 transition-colors hover:text-gold-300 hover:underline">{c.label}</a>
          : <span aria-current={i === trail.length - 1 ? 'page' : undefined} class={i === trail.length - 1 ? 'text-cream-50' : ''}>{c.label}</span>}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</nav>

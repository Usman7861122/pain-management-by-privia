---
import { cookieCategories, CONSENT_KEY, CONSENT_COOKIE } from '@/data/cookies';
---

<!-- Banner: not a blocking pop-up. Hidden until we know there is no saved choice. -->
<div id="cc-banner" role="region" aria-label="Cookie consent" hidden class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-3xl rounded-md border border-white/15 bg-charcoal-950 p-5 text-cream-100 shadow-[0_24px_60px_-20px_rgba(0,0,0,.7)] sm:bottom-5 sm:p-6">
  <p class="font-display text-base font-semibold text-cream-50">Your privacy choices</p>
  <p class="mt-2 text-sm leading-relaxed text-cream-200">We use a few cookies to keep this site working and to show maps. You decide what else is allowed. Read our <a href="/cookie-policy" class="underline decoration-gold-400 underline-offset-4 hover:text-cream-50">Cookie Policy</a>.</p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button type="button" data-cc="accept" class="btn btn-gold !min-h-11 !px-5">Accept all</button>
    <button type="button" data-cc="reject" class="btn btn-ghost !min-h-11 !px-5 !text-cream-50">Reject non-essential</button>
    <button type="button" data-cc="customize" class="btn btn-ghost !min-h-11 !px-5 !text-cream-50">Customize</button>
  </div>
</div>

<!-- Preferences window: native dialog, so focus is trapped and Esc closes it. -->
<dialog id="cc-dialog" aria-labelledby="cc-title" class="m-auto w-[min(92vw,40rem)] max-h-[90vh] overflow-y-auto rounded-md border border-charcoal-900/15 bg-cream-50 p-0 text-charcoal-950 shadow-[0_30px_80px_-20px_rgba(0,0,0,.6)] backdrop:bg-charcoal-950/70">
  <form method="dialog" class="p-6 sm:p-8" id="cc-form">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow">Cookie preferences</p>
        <h2 id="cc-title" class="mt-2 font-display text-2xl font-semibold">Choose what you allow</h2>
      </div>
      <button type="button" data-cc="close" class="-mr-2 -mt-2 inline-flex h-11 w-11 items-center justify-center rounded-md text-charcoal-600 transition hover:bg-cream-200 hover:text-charcoal-950" aria-label="Close cookie preferences">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16"/></svg>
      </button>
    </div>
    <p class="mt-3 text-charcoal-600">You can change your mind at any time with “Cookie Preferences” in the footer.</p>
    <p id="cc-gpc" hidden class="mt-4 rounded-md border border-gold-400/60 bg-gold-300/15 p-3 text-sm text-charcoal-800">Your browser is sending a Global Privacy Control signal. We treat it as a choice to keep analytics and marketing off.</p>

    <ul class="mt-6 space-y-4">
      {cookieCategories.map((c) => (
        <li class="rounded-md border border-charcoal-900/10 bg-white p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p id={`cc-l-${c.id}`} class="font-display font-semibold">{c.title}{!c.inUse && <span class="ml-2 rounded-full bg-cream-200 px-2 py-0.5 text-xs font-medium text-charcoal-600">Not used right now</span>}</p>
              <p id={`cc-d-${c.id}`} class="mt-1 text-sm leading-relaxed text-charcoal-600">{c.text}</p>
            </div>
            {c.locked ? (
              <span class="shrink-0 pt-1 text-sm font-semibold text-charcoal-600">Always on</span>
            ) : (
              <button type="button" role="switch" aria-checked="false" data-cat={c.id} aria-labelledby={`cc-l-${c.id}`} aria-describedby={`cc-d-${c.id}`} class="cc-switch relative inline-flex h-11 w-[4.5rem] shrink-0 items-center justify-center rounded-full">
                <span class="cc-track pointer-events-none block h-7 w-12 rounded-full bg-charcoal-600/40 transition-colors"></span>
                <span class="cc-knob pointer-events-none absolute left-[0.85rem] top-1/2 block h-5 w-5 -translate-y-1/2 rounded-full bg-white shadow transition-transform"></span>
                <span class="sr-only cc-state">Off</span>
              </button>
            )}
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      <button type="button" data-cc="save" class="btn btn-dark">Save my choices</button>
      <button type="button" data-cc="accept" class="btn btn-gold">Accept all</button>
      <button type="button" data-cc="reject" class="btn btn-ghost !text-charcoal-950">Reject non-essential</button>
    </div>
  </form>
</dialog>

<style is:global>
  .cc-switch:focus-visible { outline: 3px solid var(--color-gold-400); outline-offset: 2px; }
  .cc-switch[aria-checked='true'] .cc-track { background: var(--color-charcoal-900); }
  .cc-switch[aria-checked='true'] .cc-knob { transform: translate(1.5rem, -50%); }
  @media (prefers-reduced-motion: reduce) { .cc-track, .cc-knob { transition: none; } }
</style>

<script is:inline define:vars={{ KEY: CONSENT_KEY, COOKIE: CONSENT_COOKIE, cats: cookieCategories.map((c) => c.id) }}>
  (function () {
    var OPTIONAL = cats.filter(function (c) { return c !== 'necessary'; });
    var banner = document.getElementById('cc-banner');
    var dialog = document.getElementById('cc-dialog');
    var gpc = !!(navigator.globalPrivacyControl);
    var listeners = [];

    function readCookie() {
      var m = document.cookie.match(new RegExp('(?:^|; )' + COOKIE + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    }
    function load() {
      try { var raw = localStorage.getItem(KEY); if (raw) { var o = JSON.parse(raw); if (o && o.prefs) return o; } } catch (e) {}
      var c = readCookie();
      if (c) { var prefs = { necessary: true }; c.split('&').forEach(function (p) { var kv = p.split('='); prefs[kv[0]] = kv[1] === '1'; }); return { v: 1, prefs: prefs }; }
      return null;
    }
    function persist(prefs) {
      var rec = { v: 1, ts: new Date().toISOString(), prefs: prefs };
      try { localStorage.setItem(KEY, JSON.stringify(rec)); } catch (e) {}
      var val = OPTIONAL.map(function (k) { return k + '=' + (prefs[k] ? 1 : 0); }).join('&');
      document.cookie = COOKIE + '=' + encodeURIComponent(val) + '; max-age=15552000; path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
      return rec;
    }
    function defaults() { var p = { necessary: true }; OPTIONAL.forEach(function (k) { p[k] = false; }); return p; }

    var state = load();
    var current = state ? Object.assign(defaults(), state.prefs, { necessary: true }) : defaults();
    if (gpc) { current.analytics = false; current.marketing = false; }

    function activateScripts() {
      document.querySelectorAll('script[type="text/plain"][data-consent]').forEach(function (s) {
        if (s.dataset.done || !current[s.dataset.consent]) return;
        s.dataset.done = '1';
        var n = document.createElement('script');
        Array.prototype.forEach.call(s.attributes, function (a) { if (a.name !== 'type' && a.name !== 'data-consent') n.setAttribute(a.name, a.value); });
        n.text = s.text;
        s.parentNode.insertBefore(n, s.nextSibling);
      });
    }
    function emit() {
      activateScripts();
      listeners.forEach(function (fn) { try { fn(Object.assign({}, current)); } catch (e) {} });
      document.dispatchEvent(new CustomEvent('pms:consent', { detail: Object.assign({}, current) }));
    }
    function commit(next) {
      current = Object.assign(defaults(), next, { necessary: true });
      if (gpc) { current.analytics = false; current.marketing = false; }
      persist(current);
      banner.hidden = true;
      emit();
    }

    // Public API for embeds and scripts
    window.pmsConsent = {
      get: function () { return Object.assign({}, current); },
      has: function (c) { return !!current[c]; },
      set: function (patch) { commit(Object.assign({}, current, patch)); },
      onChange: function (fn) { listeners.push(fn); },
      open: function () { openDialog(); },
    };

    function syncSwitches() {
      dialog.querySelectorAll('.cc-switch').forEach(function (b) {
        var on = !!current[b.dataset.cat];
        b.setAttribute('aria-checked', on ? 'true' : 'false');
        b.querySelector('.cc-state').textContent = on ? 'On' : 'Off';
        if (gpc && (b.dataset.cat === 'analytics' || b.dataset.cat === 'marketing')) { b.disabled = true; b.setAttribute('aria-disabled', 'true'); b.style.opacity = '.5'; }
      });
      document.getElementById('cc-gpc').hidden = !gpc;
    }
    function openDialog() {
      syncSwitches();
      if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', '');
    }
    function closeDialog() { if (dialog.open) dialog.close(); }
    function all(v) { var p = {}; OPTIONAL.forEach(function (k) { p[k] = v; }); return p; }

    document.addEventListener('click', function (e) {
      var t = e.target.closest('[data-cc],[data-open-cookie-prefs],.cc-switch');
      if (!t) return;
      if (t.hasAttribute('data-open-cookie-prefs')) { e.preventDefault(); openDialog(); return; }
      if (t.classList.contains('cc-switch')) {
        if (t.disabled) return;
        var on = t.getAttribute('aria-checked') !== 'true';
        t.setAttribute('aria-checked', on ? 'true' : 'false');
        t.querySelector('.cc-state').textContent = on ? 'On' : 'Off';
        return;
      }
      var a = t.getAttribute('data-cc');
      if (a === 'accept') { commit(all(true)); closeDialog(); }
      else if (a === 'reject') { commit(all(false)); closeDialog(); }
      else if (a === 'customize') { openDialog(); }
      else if (a === 'close') { closeDialog(); }
      else if (a === 'save') {
        var p = {};
        dialog.querySelectorAll('.cc-switch').forEach(function (b) { p[b.dataset.cat] = b.getAttribute('aria-checked') === 'true'; });
        commit(p); closeDialog();
      }
    });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) closeDialog(); });

    if (!state) banner.hidden = false;
    emit();
  })();
</script>

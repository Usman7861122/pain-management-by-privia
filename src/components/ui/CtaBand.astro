---
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { site } from '@/data/site';
const { title = 'Ready to feel better?', text = 'Choose your provider and schedule online, or call our team. We are happy to help.' } = Astro.props;
---

<section class="on-dark bg-charcoal-950 py-16 lg:py-20">
  <div class="container-x flex flex-col items-center text-center" data-reveal>
    <h2 class="h2 max-w-2xl">{title}</h2>
    <p class="lead mt-4 max-w-xl">{text}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={FIND_A_DOCTOR_URL} class="btn btn-gold">See My Provider</a>
      <a href={`tel:${site.phone.tel}`} class="btn btn-ghost !text-cream-50">Call {site.phone.display}</a>
    </div>
  </div>
</section>

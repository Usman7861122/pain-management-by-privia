---
import { site, mapsUrl } from '@/data/site';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
const { tint = false } = Astro.props;

const cityInfo: Record<string, { img: string; text: string }> = {
  rockville: { img: '/images/locations/rockville.jpg', text: 'Our Rockville office serves Rockville, Bethesda, Gaithersburg, Potomac and the rest of Montgomery County.' },
  frederick: { img: '/images/interventional/frederick-town.jpg', text: 'Our Frederick office serves Frederick, Urbana, Walkersville, Thurmont and the rest of Frederick County.' },
};
---

  <section class={tint ? 'bg-cream-100 section' : 'section'}>
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Where we are</p>
        <h2 class="h2 mt-4">Pain care in Rockville and Frederick.</h2>
        <p class="lead mt-4">Choose the office that is easiest for you. Both offer the same physicians and the same full range of treatments.</p>
      </div>
      <ul class="mt-14 grid gap-8 md:grid-cols-2">
        {site.locations.map((l, i) => (
          <li data-reveal style={`--d:${i * 120}ms`}>
            <article class="group overflow-hidden rounded-md border border-charcoal-900/10 bg-white shadow-[0_24px_50px_-34px_rgba(27,28,31,0.5)] transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400">
              <div class="aspect-[16/9] overflow-hidden bg-cream-100">
                <img src={cityInfo[l.slug].img} alt={`${l.city}, Maryland`} width="1200" height="675" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-[1.05]" />
              </div>
              <div class="p-7 sm:p-8">
                <h3 class="font-display text-2xl font-semibold">{l.city}, {l.state}</h3>
                <p class="mt-3 text-charcoal-600">{cityInfo[l.slug].text}</p>
                <address class="mt-5 not-italic text-charcoal-800">{l.street}<br />{l.city}, {l.state} {l.zip}</address>
                <p class="mt-2 text-sm text-charcoal-600">Appointments: <a href={`tel:${l.phone.tel}`} class="font-semibold text-charcoal-950 underline decoration-gold-400 underline-offset-4">{l.phone.display}</a></p>
                <div class="mt-6 flex flex-wrap items-center gap-3">
                  <a href={FIND_A_DOCTOR_URL} class="btn btn-dark !min-h-10 !px-5">Book in {l.city}</a>
                  <a href={mapsUrl(l)} class="link-arrow text-gold-700" target="_blank" rel="noopener">Directions</a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>


---
import { site, mapsUrl } from '@/data/site';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
const { tint = false, city, serviceTitle = '' } = Astro.props;
import { locationDetails } from '@/data/locationDetails';
const one = city ? site.locations.find((l) => l.slug === city) : undefined;
const det = city ? locationDetails[city] : undefined;
const sname = serviceTitle.replace(/ Procedure$/, '');

const cityInfo: Record<string, { img: string; text: string }> = {
  rockville: { img: '/images/locations/rockville.jpg', text: 'Our Rockville office serves Rockville, Bethesda, Gaithersburg, Potomac and the rest of Montgomery County.' },
  frederick: { img: '/images/interventional/frederick-town.jpg', text: 'Our Frederick office serves Frederick, Urbana, Walkersville, Thurmont and the rest of Frederick County.' },
};
---

{one && det ? (
  <section class={tint ? 'bg-cream-100 section' : 'section'}>
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Where we are</p>
        <h2 class="h2 mt-4">{sname || 'Pain care'} at our <span class="text-gold-700">{one.city}</span> office.</h2>
        <p class="lead mt-4">{cityInfo[one.slug].text} Same physicians, same full range of treatments.</p>
      </div>
      <article class="mt-14 overflow-hidden rounded-md border border-charcoal-900/10 bg-white shadow-[0_24px_50px_-34px_rgba(27,28,31,0.5)] lg:grid lg:grid-cols-2" data-reveal>
        <div class="aspect-[16/10] overflow-hidden bg-cream-100 lg:aspect-auto"><img src={det.heroImage} alt={`${one.city}, Maryland`} width="1200" height="750" loading="lazy" class="h-full w-full object-cover" /></div>
        <div class="p-8 sm:p-10 lg:p-12">
          <h3 class="font-display text-2xl font-semibold">{one.city}, {one.state}</h3>
          <address class="mt-4 not-italic text-lg text-charcoal-800">{one.street}<br />{one.city}, {one.state} {one.zip}</address>
          <p class="mt-3 text-charcoal-600">Appointments: <a href={`tel:${one.phone.tel}`} class="font-semibold text-charcoal-950 underline decoration-gold-400 underline-offset-4">{one.phone.display}</a></p>
          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-gold-700">{sname} patients come from</p>
          <ul class="mt-3 flex flex-wrap gap-2">{det.serves.map((t) => <li class="rounded-md border border-charcoal-900/15 bg-cream-50 px-3 py-1.5 text-sm text-charcoal-800">{t}</li>)}</ul>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href={FIND_A_DOCTOR_URL} class="btn btn-dark !px-6">Book in {one.city}</a>
            <a href={mapsUrl(one)} class="link-arrow text-gold-700" target="_blank" rel="noopener">Directions</a>
            <a href={`/locations/${one.slug}`} class="link-arrow text-gold-700">Office page</a>
          </div>
        </div>
      </article>
    </div>
  </section>
) : (
  <section class={tint ? 'bg-cream-100 section' : 'section'}>
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Where we are</p>
        <h2 class="h2 mt-4">Pain care in Rockville and Frederick.</h2>
        <p class="lead mt-4">Choose the office that is easiest for you. Both offer the same physicians and the same full range of treatments.</p>
      </div>
      <ul class="mt-14 grid gap-8 md:grid-cols-2">
        {site.locations.map((l, i) => (
          <li data-reveal style={`--d:${i * 120}ms`}>
            <article class="group overflow-hidden rounded-md border border-charcoal-900/10 bg-white shadow-[0_24px_50px_-34px_rgba(27,28,31,0.5)] transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400">
              <div class="aspect-[16/9] overflow-hidden bg-cream-100">
                <img src={cityInfo[l.slug].img} alt={`${l.city}, Maryland`} width="1200" height="675" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-[1.05]" />
              </div>
              <div class="p-7 sm:p-8">
                <h3 class="font-display text-2xl font-semibold">{l.city}, {l.state}</h3>
                <p class="mt-3 text-charcoal-600">{cityInfo[l.slug].text}</p>
                <address class="mt-5 not-italic text-charcoal-800">{l.street}<br />{l.city}, {l.state} {l.zip}</address>
                <p class="mt-2 text-sm text-charcoal-600">Appointments: <a href={`tel:${l.phone.tel}`} class="font-semibold text-charcoal-950 underline decoration-gold-400 underline-offset-4">{l.phone.display}</a></p>
                <div class="mt-6 flex flex-wrap items-center gap-3">
                  <a href={FIND_A_DOCTOR_URL} class="btn btn-dark !min-h-10 !px-5">Book in {l.city}</a>
                  <a href={mapsUrl(l)} class="link-arrow text-gold-700" target="_blank" rel="noopener">Directions</a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

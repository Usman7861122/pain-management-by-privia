---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

interface Props { title: string; description?: string; eyebrow?: string; lead?: string; image?: string; imageAlt?: string; highlight?: string[]; nearby?: string; crumb?: string; crumbs?: { label: string; href?: string }[] }
const { title, description, eyebrow, lead, image, imageAlt = '', highlight = [], nearby, crumb, crumbs } = Astro.props;
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const titleHtml = highlight.reduce((h, w) => h.replaceAll(esc(w), `<span class="text-gold-300">${esc(w)}</span>`), esc(title));
---

<BaseLayout title={title} description={description}>
  {image ? (
    <section class="on-dark relative overflow-hidden bg-charcoal-950 pb-16 pt-14 lg:pb-24 lg:pt-20">
      <div class="pointer-events-none absolute inset-0 opacity-50 [background-image:radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] [background-size:28px_28px] [mask-image:radial-gradient(ellipse_80%_80%_at_70%_40%,#000_40%,transparent_100%)]" aria-hidden="true"></div>
      <div class="container-x relative grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7" data-reveal>
          <Breadcrumbs title={title} crumb={crumb} crumbs={crumbs} />
          {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
          <h1 class="text-balance font-display text-[clamp(2.1rem,1.4rem+2.8vw,3.6rem)] font-semibold leading-[1.08] tracking-tight text-cream-50" set:html={titleHtml}></h1>
          {lead && <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-200">{lead}</p>}
        </div>
        <div class="relative lg:col-span-5" data-reveal style="--d:120ms">
          <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
          <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-charcoal-800">
            <img src={image} alt={imageAlt} width="1200" height="900" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
      {nearby && (
        <div class="container-x relative mt-14 lg:mt-16" data-reveal>
          <div class="border-t border-white/15 pt-7">
            <p class="flex items-start gap-4 text-[1.0625rem] leading-relaxed text-cream-200">
              <svg class="mt-1 shrink-0 text-gold-400" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span set:html={nearby}></span>
            </p>
          </div>
        </div>
      )}
    </section>
  ) : (
    <section class="on-dark bg-charcoal-950 pb-16 pt-20 lg:pb-24 lg:pt-28">
      <div class="container-x">
        <Breadcrumbs title={title} crumb={crumb} crumbs={crumbs} />
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h1 class="h2 text-balance max-w-3xl !text-[clamp(2rem,1.4rem+2.2vw,3.2rem)]" set:html={titleHtml}></h1>
        {nearby && (
          <div class="mt-12 border-t border-white/15 pt-7">
            <p class="flex items-start gap-4 text-[1.0625rem] leading-relaxed text-cream-200">
              <svg class="mt-1 shrink-0 text-gold-400" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span set:html={nearby}></span>
            </p>
          </div>
        )}
      </div>
    </section>
  )}
  <slot />
  <slot name="after" />
</BaseLayout>

---
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSubnav from '@/components/ui/AboutSubnav.astro';
import CtaBand from '@/components/ui/CtaBand.astro';

const pillars = [
  { t: 'Find the cause first', d: 'We look for the real source of your pain, using only the tests you need. That saves you time and cost.', icon: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/>' },
  { t: 'A plan that fits you', d: 'Care can start with simple advice and education. When it helps, we move on to targeted procedures.', icon: '<path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/>' },
  { t: 'Teamwork around you', d: 'We work with your primary care doctor, other specialists, psychologists, chiropractors and physical therapists.', icon: '<circle cx="8" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.5"/><path d="M3 19c.5-3 2.5-5 5-5s4.5 2 5 5M14 19c.4-2 1.6-3.5 3.5-3.5S20.6 17 21 19"/>' },
];
const stats = [
  { n: '1998', l: 'The year we began caring for patients' },
  { n: '2', l: 'Maryland offices: Rockville and Frederick' },
  { n: '2', l: 'Board certified pain physicians' },
];
---

<PageLayout title="Pain care built around you." eyebrow="About us" lead="Since 1998, Pain Management Specialists has helped people in Rockville and Frederick find the cause of their pain and get back to the life they love." image="/images/about/team-smile.jpg" imageAlt="Smiling doctors reviewing information together on a tablet" description="Pain Management Specialists has served Rockville and Frederick, Maryland since 1998.">
  <AboutSubnav />

  <section class="section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 class="h2 mt-4">Care that looks at the whole person.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">We started in 1998 with a simple idea: pain care should be personal. Today we treat pain that comes from spine problems, nerve injury, surgery and cancer, at two offices in Maryland.</p>
        <p class="lead mt-4">Our board certified physicians, Dr. Stuart Hough and Dr. Ramani Peruvemba, use more than one kind of treatment. Each plan is built around you, from the first visit to long-term follow-up.</p>
        <a href="/doctors" class="link-arrow mt-8 text-gold-700">Meet our physicians</a>
      </div>
      <div class="relative lg:col-span-6" data-reveal style="--d:120ms">
        <div class="absolute -bottom-4 -left-4 h-2/3 w-2/3 rounded-md bg-cream-200" aria-hidden="true"></div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-md">
          <img src="/images/about/team-tablet.jpg" alt="Three healthcare professionals reviewing a tablet together" width="1200" height="800" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] hover:scale-[1.04]" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-charcoal-950 py-14 text-cream-50 on-dark">
    <ul class="container-x grid gap-8 text-center sm:grid-cols-3">
      {stats.map((s, i) => (
        <li data-reveal style={`--d:${i * 100}ms`}>
          <p class="font-display text-5xl font-semibold text-gold-300">{s.n}</p>
          <p class="mx-auto mt-2 max-w-[22ch] text-sm text-cream-200">{s.l}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">How we care</p>
        <h2 class="h2 mt-4">Simple ideas we follow every day.</h2>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <li data-reveal style={`--d:${i * 100}ms`} class="group rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-cream-100 text-gold-700 transition duration-500 group-hover:bg-charcoal-950 group-hover:text-gold-300">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon}></svg>
            </span>
            <h3 class="mt-6 font-display text-xl font-semibold">{p.t}</h3>
            <p class="mt-3 text-charcoal-600">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2 class="h2 mt-4">Patients first. Always.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Our goal is to put your needs ahead of everything else. We replace costly or unneeded treatments with time, attention and clear explanations, so you always know what comes next and why.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end" data-reveal style="--d:120ms">
        <a href="/conditions" class="btn btn-dark">Conditions we treat</a>
        <a href="/services" class="btn border border-charcoal-950/30 text-charcoal-950 hover:border-gold-600 hover:bg-cream-200">Our services</a>
      </div>
    </div>
  </section>

  <CtaBand slot="after" />
</PageLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TunnelHero from '@/components/home/TunnelHero';
import About from '@/components/home/About.astro';
import PriviaSection from '@/components/home/PriviaSection.astro';
import Mission from '@/components/home/Mission.astro';
import Services from '@/components/home/Services.astro';
import Conditions from '@/components/home/Conditions.astro';
import VirtualVisit from '@/components/home/VirtualVisit.astro';
import Awards from '@/components/home/Awards.astro';
import Providers from '@/components/home/Providers.astro';
import ParallaxBand from '@/components/home/ParallaxBand.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import Locations from '@/components/home/Locations.astro';
import { site, mapsUrl } from '@/data/site';
import { img } from '@/data/images';
import { links } from '@/data/privia';

const tunnelImages = [
  { src: '/images/tunnel/hurdler.jpg', title: 'Clear every hurdle' },
  { src: '/images/tunnel/stretch.jpg', title: 'Move with ease' },
  { src: '/images/tunnel/boxer.jpg', title: 'Back in the fight' },
  { src: '/images/tunnel/plank.jpg', title: 'Strong again' },
  { src: '/images/tunnel/swimmer.jpg', title: 'Stroke after stroke' },
  { src: '/images/tunnel/warmup.jpg', title: 'Train together' },
  { src: '/images/tunnel/sprinter.jpg', title: 'Get back to your stride' },
  { src: '/images/tunnel/dumbbell.jpg', title: 'Lift without pain' },
  { src: '/images/tunnel/soccer.jpg', title: 'Back on the pitch' },
];
const locations = site.locations.map((l) => ({ ...l, mapsHref: mapsUrl(l) }));
---

<BaseLayout overlay title="Interventional Pain Management in Rockville & Frederick, MD" description={site.description}>
  <TunnelHero client:load images={tunnelImages} primary={{ label: 'See My Provider', href: links.seeMyProvider }} phone={site.phone} locations={locations} />
  <About />
  <PriviaSection />
  <Mission />
  <Services />
  <Conditions />
  <VirtualVisit />
  <Awards />
  <Providers />
  <ParallaxBand />
  <BlogPreview />
  <Locations />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSlider from '@/components/home/HeroSlider';
import About from '@/components/home/About.astro';
import PriviaSection from '@/components/home/PriviaSection.astro';
import Mission from '@/components/home/Mission.astro';
import Services from '@/components/home/Services.astro';
import Conditions from '@/components/home/Conditions.astro';
import VirtualVisit from '@/components/home/VirtualVisit.astro';
import Awards from '@/components/home/Awards.astro';
import Providers from '@/components/home/Providers.astro';
import ParallaxBand from '@/components/home/ParallaxBand.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import Locations from '@/components/home/Locations.astro';
import { site, mapsUrl } from '@/data/site';
import { img } from '@/data/images';
import { links } from '@/data/privia';

const slides = [
  { image: img.hero[0], eyebrow: 'Interventional pain management', title: 'Relief that begins with being heard.', text: 'Board certified physicians offering modern, non-opioid focused care in Rockville and Frederick.' },
  { image: img.hero[1], eyebrow: 'Precise, image-guided care', title: 'Targeted treatment for the source of your pain.', text: 'Minimally invasive procedures, explained clearly and delivered with care.' },
  { image: img.hero[2], eyebrow: 'Back, neck, nerve and joint pain', title: 'Move through life with more comfort.', text: 'A personal plan built around your history, your goals and your daily life.' },
  { image: img.hero[3], eyebrow: 'Care that fits your day', title: 'See your provider in person or online.', text: 'Two Maryland offices and virtual visits for many follow-up appointments.' },
];
const locations = site.locations.map((l) => ({ ...l, mapsHref: mapsUrl(l) }));
---

<BaseLayout overlay title="Interventional Pain Management in Rockville & Frederick, MD" description={site.description}>
  <HeroSlider client:load slides={slides} primary={{ label: 'See My Provider', href: links.seeMyProvider }} phone={site.phone} locations={locations} />
  <About />
  <PriviaSection />
  <Mission />
  <Services />
  <Conditions />
  <VirtualVisit />
  <Awards />
  <Providers />
  <ParallaxBand />
  <BlogPreview />
  <Locations />
</BaseLayout>

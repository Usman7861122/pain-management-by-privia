---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AthleteHero from '@/components/home/AthleteHero';
import About from '@/components/home/About.astro';
import PriviaSection from '@/components/home/PriviaSection.astro';
import Mission from '@/components/home/Mission.astro';
import Services from '@/components/home/Services.astro';
import Conditions from '@/components/home/Conditions.astro';
import VirtualVisit from '@/components/home/VirtualVisit.astro';
import Awards from '@/components/home/Awards.astro';
import Providers from '@/components/home/Providers.astro';
import ParallaxBand from '@/components/home/ParallaxBand.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import Locations from '@/components/home/Locations.astro';
import { site, mapsUrl } from '@/data/site';
import { img } from '@/data/images';
import { links } from '@/data/privia';

const slides = [
  { image: '/images/athletes/running.jpg', sport: 'Running', eyebrow: '', title: 'Clear every hurdle, pain free.', text: 'Pain should not decide when you stop. Our physicians treat the cause, so you can run, work and live again.', pos: '50% 40%' },
  { image: '/images/athletes/jogging.jpg', sport: 'Jogging', eyebrow: '', title: 'Keep moving with the people you love.', text: 'Shoulder, neck, hip and back pain should not slow you down. Gentle, precise care helps you get moving again.', pos: '50% 40%' },
  { image: '/images/athletes/exercise.jpg', sport: 'Exercise', eyebrow: '', title: 'Strong again, together.', text: 'From old injuries to long-term nerve pain, our team builds a plan so you can train and move with confidence.', pos: '50% 40%' },
];
const locations = site.locations.map((l) => ({ ...l, mapsHref: mapsUrl(l) }));
---

<BaseLayout overlay title="Interventional Pain Management in Rockville & Frederick, MD" description={site.description}>
  <AthleteHero client:load slides={slides} primary={{ label: 'See My Provider', href: links.seeMyProvider }} phone={site.phone} locations={locations} />
  <About />
  <PriviaSection />
  <Mission />
  <Services />
  <Conditions />
  <VirtualVisit />
  <Awards />
  <Providers />
  <ParallaxBand />
  <BlogPreview />
  <Locations />
</BaseLayout>

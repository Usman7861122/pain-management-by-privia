---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSubnav from '@/components/ui/AboutSubnav.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const items = await getCollection('doctors');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const groups = [
  { t: 'Board certification', list: d.certifications },
  { t: 'Leadership', list: d.leadership },
  { t: 'Hospital affiliations', list: d.affiliations },
  { t: 'Professional memberships', list: d.memberships },
  { t: 'Awards and recognition', list: d.awards },
  { t: 'Languages', list: d.languages },
].filter((g) => g.list.length);
---

<PageLayout title={d.name} eyebrow={d.title} description={d.intro}>
  <AboutSubnav />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+5rem)]" data-reveal>
          <div class="relative">
            <span class="absolute inset-0 translate-x-3 translate-y-3 rounded-md border border-gold-400/50" aria-hidden="true"></span>
            <div class="relative aspect-square overflow-hidden rounded-md bg-cream-100 shadow-[0_24px_50px_-30px_rgba(27,28,31,0.5)]">
              <img src={d.photo ?? `/images/providers/${entry.id}.jpg`} alt={d.name} width="800" height="800" class="h-full w-full object-cover object-top" />
            </div>
          </div>
          <h2 class="mt-10 font-display text-3xl font-semibold">{d.name}</h2>
          <p class="mt-1 text-charcoal-600">{d.title}</p>
          <p class="mt-4 text-sm text-charcoal-600">Accepting new patients. Virtual visits available.</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href={FIND_A_DOCTOR_URL} class="btn btn-gold">Schedule online</a>
            <a href={`tel:${site.phone.tel}`} class="btn border border-charcoal-950/30 text-charcoal-950 hover:border-gold-600 hover:bg-cream-200">Call {site.phone.display}</a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-8">
        <div data-reveal>
          <p class="eyebrow">About {d.name.split(',')[0]}</p>
          <p class="mt-4 font-display text-2xl font-semibold leading-snug text-charcoal-950">{d.intro}</p>
          <div class="mt-6 space-y-4 text-lg leading-relaxed text-charcoal-600 [&_p]:max-w-2xl"><Content /></div>
        </div>

        {d.expertise.length > 0 && (
          <div class="mt-12" data-reveal>
            <h2 class="eyebrow">Areas of expertise</h2>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {d.expertise.map((e) => <li class="rounded-md border border-charcoal-900/15 bg-cream-50 px-4 py-2 text-sm text-charcoal-800 transition duration-300 hover:border-gold-600 hover:bg-cream-100">{e}</li>)}
            </ul>
          </div>
        )}

        {d.education.length > 0 && (
          <div class="mt-12" data-reveal>
            <h2 class="eyebrow">Education and training</h2>
            <ol class="mt-6 border-l border-gold-400/60">
              {d.education.map((e) => (
                <li class="relative pb-6 pl-7 last:pb-0">
                  <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-400 ring-4 ring-cream-50"></span>
                  <p class="font-display text-sm font-semibold text-gold-700">{e.year}</p>
                  <p class="mt-1 text-charcoal-800">{e.text}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div class="mt-12 grid gap-5 sm:grid-cols-2" data-reveal>
          {groups.map((g) => (
            <section class="rounded-md border border-charcoal-900/10 bg-cream-50 p-6 transition duration-500 hover:-translate-y-1 hover:border-gold-400 hover:bg-white">
              <h2 class="eyebrow">{g.t}</h2>
              <ul class="mt-4 space-y-2 text-sm text-charcoal-800">
                {g.list.map((x) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>{x}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
  <CtaBand slot="after" />
</PageLayout>

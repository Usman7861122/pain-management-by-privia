---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import { site } from '@/data/site';

const steps = [
  { t: 'Find your insurance details', d: 'Have your insurance card handy. It lists your plan name and member ID.' },
  { t: 'Call the office', d: 'Ask whether your plan is accepted and what to expect. Our team is happy to help.' },
  { t: 'Check with your plan too', d: 'Your insurance company can tell you about your benefits, copays and any deductible.' },
  { t: 'Ask about approvals', d: 'Some tests and procedures may need prior authorization from your plan. Ask us if one applies to you.' },
];
---

<!-- VERIFY with practice: list of accepted insurance plans and any fee or self-pay information from the old website. Must not contradict the Privia Financial Policy. -->
<!-- VERIFY with practice: link to the Financial Policy form if a public page exists. Currently the form is on the Resources page. -->
<PageLayout title="Insurance and billing questions, answered." crumb="Insurance & Fees" highlight={['Insurance']} eyebrow="Resources" lead="We want you to feel clear about coverage before your visit. Here is how to check, and who to call." image="/images/tunnel/clinic-3.jpg" imageAlt="A bright, welcoming clinic space" description="How to check your insurance coverage for Pain Management Specialists in Rockville and Frederick, MD.">
  <section class="section">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">Before you come in</p>
        <h2 class="h2 mt-4">Please check your coverage first.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Insurance plans are different, and they can change. The best way to know if your plan is accepted is to call the office before your visit.</p>
        <ul class="mt-8 space-y-3 text-lg text-charcoal-800">
          <li class="flex gap-3"><Check /><span>Bring your insurance card and a photo ID to every visit</span></li>
          <li class="flex gap-3"><Check /><span>Tell us right away if your insurance changes</span></li>
          <li class="flex gap-3"><Check /><span>Ask if a test or procedure needs prior authorization</span></li>
        </ul>
      </div>
      <div class="lg:col-span-6" data-reveal style="--d:120ms">
        <div class="rounded-md border border-gold-400/50 bg-gradient-to-br from-white via-cream-50 to-cream-100 p-8 shadow-[0_30px_60px_-40px_rgba(95,76,0,.45)] sm:p-10">
          <p class="eyebrow">Call us</p>
          <p class="mt-4 font-display text-2xl font-semibold leading-snug text-charcoal-950">Questions about coverage or billing?</p>
          <p class="mt-3 text-charcoal-600">Our team can help. Call the main line or your office.</p>
          <ul class="mt-6 space-y-2 text-lg">
            <li><a href={`tel:${site.phone.tel}`} class="inline-flex min-h-11 items-center font-semibold underline decoration-gold-400 underline-offset-4 hover:text-gold-700">Main line: {site.phone.display}</a></li>
            {site.locations.map((l) => (<li><a href={`tel:${l.phone.tel}`} class="inline-flex min-h-11 items-center font-semibold underline decoration-gold-400 underline-offset-4 hover:text-gold-700">{l.name}: {l.phone.display}</a></li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">How to check</p>
        <h2 class="h2 mt-4">Four easy steps.</h2>
      </div>
      <ol class="relative mx-auto mt-14 max-w-3xl space-y-10 before:absolute before:bottom-4 before:left-6 before:top-4 before:w-px before:bg-gold-400/50">
        {steps.map((s, i) => (
          <li class="relative flex gap-6" data-reveal style={`--d:${i * 80}ms`}>
            <span class="relative z-10 grid h-12 w-12 shrink-0 place-items-center rounded-full bg-charcoal-950 font-display text-lg font-semibold text-gold-300" aria-hidden="true">{i + 1}</span>
            <div class="pt-1"><h3 class="font-display text-xl font-semibold"><span class="sr-only">Step {i + 1}: </span>{s.t}</h3><p class="mt-2 text-lg text-charcoal-600">{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-3xl rounded-md border border-charcoal-900/10 bg-cream-50 p-8 sm:p-10" data-reveal>
        <p class="eyebrow">Financial policy</p>
        <h2 class="mt-3 font-display text-2xl font-semibold">Please review our Financial Policy.</h2>
        <p class="mt-4 text-charcoal-600">A Financial Policy applies to all patients. It explains your financial responsibility for the care you receive. You can find it with our other patient forms.</p>
        <a href="/resources" class="link-arrow mt-4 text-gold-700">Patient forms and policies</a>
      </div>
    </div>
  </section>

  <CtaBand slot="after" title="Have a question about your coverage?" text="Call our team, or choose your provider and schedule online." />
</PageLayout>

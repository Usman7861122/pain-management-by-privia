---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { nearbyAreasHtml } from '@/data/site';
import { conditionGroups } from '@/data/conditionGroups';

export async function getStaticPaths() {
  const items = await getCollection('conditions');
  const services = await getCollection('services');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: items, services } }));
}
const { entry, all, services } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const rich = Boolean(d.lead);
const group = conditionGroups.find((g) => g.ids.includes(entry.id));
const heroTitle = d.heroTitle ?? `${d.title} Treatment in Rockville and Frederick, MD.`;
const related = d.related.map((id) => all.find((x) => x.id === id)).filter(Boolean);
const treatments = d.treatments.map((id) => services.find((x) => x.id === id)).filter(Boolean);
const cimg = (e: any) => e.data.heroImage || e.data.image || `/images/conditions/${e.id}.jpg`;

const hash = [...entry.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 11);
const pick = <T,>(arr: T[], k: number) => arr[(hash + k) % arr.length];
const landscape = ['/images/about/exam-senior.jpg','/images/about/examine-back.jpg','/images/about/movement.jpg','/images/about/team-smile.jpg','/images/interventional/spine-injection.jpg','/images/sections/about.jpg','/images/sections/virtual-visit.jpg','/images/about/team-tablet.jpg'];
const portrait = ['/images/tunnel/clinic-2.jpg','/images/tunnel/clinic-3.jpg','/images/tunnel/clinic-4.jpg','/images/tunnel/consult-senior.jpg','/images/tunnel/diagnosis.jpg','/images/tunnel/doctor-patient.jpg','/images/tunnel/physio-spine.jpg','/images/tunnel/spine-anatomy.jpg','/images/tunnel/spine-model.jpg'];
const wide = ['/images/sections/parallax.jpg','/images/sections/mission.jpg','/images/hero/hero-2.jpg','/images/hero/hero-3.jpg','/images/hero/hero-4.jpg'];
const heroImg = d.heroImage ?? d.image ?? `/images/conditions/${entry.id}.jpg`;
const basicsImg = d.basicsImage ?? pick(landscape, 0);
const symImg = d.symptomsImage ?? pick(portrait, 1);
const diagImg = d.diagnosisImage ?? pick(portrait, 4);
const seekImg = d.seekImage ?? pick(wide, 2);
const gal = d.gallery.length >= 3 ? d.gallery : [pick(landscape, 3), pick(landscape, 5), pick(landscape, 7)];
---

{rich ? (
  <PageLayout title={heroTitle} crumb={d.title} crumbs={[{ label: 'Conditions', href: '/conditions' }, ...(group ? [{ label: group.title, href: `/conditions/${group.slug}` }] : [])]} highlight={['Rockville', 'Frederick']} eyebrow="Condition" lead={d.lead} image={heroImg} imageAlt={d.heroAlt} description={d.summary} nearby={nearbyAreasHtml}>
    <section class="section overflow-hidden pb-28 lg:pb-36">
      <div class="container-x grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-6" data-reveal>
          <p class="eyebrow">The basics</p>
          <h2 class="h2 mt-4">What is {d.title.toLowerCase().replace(/^(?!cancer|complex)/, '')}?</h2>
          <div class="rule-gold mt-6"></div>
          <div class="prose-lux mt-6 space-y-4 text-lg leading-relaxed text-charcoal-600 [&_strong]:text-charcoal-950"><Content /></div>
        </div>
        <div class="relative lg:col-span-6" data-reveal style="--d:120ms">
          <div class="absolute -right-4 -top-4 hidden h-full w-full rounded-md border border-gold-400/50 lg:block" aria-hidden="true"></div>
          <div class="relative aspect-[5/4] overflow-hidden rounded-md bg-charcoal-800 shadow-[0_40px_70px_-40px_rgba(0,0,0,.6)]">
            <img src={basicsImg} alt="" width="1200" height="960" loading="lazy" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/40 via-transparent to-transparent"></div>
          </div>
          {d.facts.length > 0 && (
            <dl class="relative z-10 mt-6 rounded-md border border-gold-400/60 bg-cream-50/95 p-7 shadow-[0_30px_60px_-30px_rgba(40,30,0,.5)] backdrop-blur lg:absolute lg:-bottom-16 lg:-left-14 lg:mt-0 lg:w-[20rem]">
              <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent" aria-hidden="true"></span>
              <p class="eyebrow mb-5">At a glance</p>
              {d.facts.map((f, i) => (
                <div class={i > 0 ? 'mt-4 border-t border-charcoal-900/10 pt-4' : ''}>
                  <dt class="font-display text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-gold-700">{f.k}</dt>
                  <dd class="mt-1 font-display text-lg font-semibold leading-snug text-charcoal-950">{f.v}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>

    {d.symptoms.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-reveal>
            <div class="absolute -bottom-4 -left-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
            <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800">
              <img src={symImg} alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-charcoal-950/80 to-transparent p-6 pt-20"><p class="font-display text-lg font-semibold text-cream-50">You do not have to live with it.</p></div>
            </div>
          </div>
          <div class="lg:col-span-7" data-reveal style="--d:100ms">
            <p class="eyebrow">Symptoms</p>
            <h2 class="h2 mt-4">{d.symptomsTitle}</h2>
            <div class="rule-gold mt-6"></div>
            <ul class="mt-8 space-y-3">
              {d.symptoms.map((c) => (
                <li class="flex items-center gap-4 rounded-md border border-charcoal-900/10 bg-cream-50 px-5 py-4 text-lg text-charcoal-800 transition duration-500 ease-[var(--ease-lux)] hover:translate-x-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_18px_36px_-24px_rgba(95,76,0,.5)]">
                  <Check /><span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {d.causes.length > 0 && (
      <section class="section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Causes</p>
            <h2 class="h2 mt-4">{d.causesTitle}</h2>
          </div>
          <ul class="mt-14 grid gap-6 sm:grid-cols-2">
            {d.causes.map((c, i) => (
              <li data-reveal style={`--d:${(i % 2) * 90}ms`} class="group relative overflow-hidden rounded-md border border-charcoal-900/10 bg-gradient-to-br from-white to-cream-100 p-8 pt-10 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:shadow-[0_26px_46px_-26px_rgba(95,76,0,.5)]">
                <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-[.18] bg-gold-400 transition-transform duration-700 ease-[var(--ease-lux)] group-hover:scale-x-100" aria-hidden="true"></span>
                <span class="pointer-events-none absolute -right-2 -top-4 font-display text-8xl font-bold text-charcoal-900/[.04]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="relative font-display text-xl font-semibold">{c.t}</h3>
                <p class="relative mt-3 text-lg leading-relaxed text-charcoal-600">{c.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="pb-2" aria-hidden="true">
      <div class="container-x grid h-auto gap-4 sm:h-[30rem] sm:grid-cols-3 sm:grid-rows-2" data-reveal>
        <div class="h-64 overflow-hidden rounded-md sm:row-span-2 sm:h-auto"><img src={gal[0]} alt="" loading="lazy" width="900" height="900" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] hover:scale-105" /></div>
        <div class="h-56 overflow-hidden rounded-md sm:col-span-2 sm:h-auto"><img src={gal[1]} alt="" loading="lazy" width="1200" height="600" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] hover:scale-105" /></div>
        <div class="relative h-56 overflow-hidden rounded-md bg-charcoal-950 sm:col-span-2 sm:h-auto">
          <img src={gal[2]} alt="" loading="lazy" width="1200" height="600" class="h-full w-full object-cover opacity-70" />
          <div class="absolute inset-0 flex items-end bg-gradient-to-t from-charcoal-950/85 to-transparent p-7"><p class="max-w-md font-display text-xl font-semibold leading-snug text-cream-50">Board-certified care, close to home in Rockville and Frederick.</p></div>
        </div>
      </div>
    </section>

    {d.diagnosis.length > 0 && (
      <section class="section">
        <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow">Diagnosis</p>
            <h2 class="h2 mt-4 max-w-xl">{d.diagnosisTitle}</h2>
            <ol class="relative mt-12 space-y-9 before:absolute before:bottom-3 before:left-[1.4rem] before:top-3 before:w-px before:bg-gradient-to-b before:from-gold-400 before:via-gold-400/40 before:to-transparent">
              {d.diagnosis.map((s, i) => (
                <li class="relative flex gap-6">
                  <span class="relative z-10 grid h-11 w-11 shrink-0 place-items-center rounded-full border border-gold-400 bg-charcoal-950 font-display text-sm font-semibold text-gold-300 shadow-[0_0_0_6px_var(--color-cream-50)]">{String(i + 1).padStart(2, '0')}</span>
                  <div class="pt-1">
                    <h3 class="font-display text-xl font-semibold text-charcoal-950">{s.t}</h3>
                    <p class="mt-2 text-lg leading-relaxed text-charcoal-600">{s.d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="lg:col-span-5" data-reveal style="--d:120ms">
            <div class="relative mx-auto max-w-md lg:sticky lg:top-32 lg:max-w-none">
              <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
              <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800"><img src={diagImg} alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" /></div>
            </div>
          </div>
        </div>
      </section>
    )}

    {treatments.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Treatment</p>
            <h2 class="h2 mt-4">{d.treatmentsTitle}</h2>
            {d.treatmentsIntro && <p class="lead mt-5">{d.treatmentsIntro}</p>}
          </div>
          <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {treatments.map((t, i) => (
              <li data-reveal style={`--d:${(i % 3) * 80}ms`}>
                <a href={`/services/${t!.id}`} class="group flex h-full flex-col overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
                  <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={t!.data.heroImage || `/images/services/${t!.id}.jpg`} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.07]" /></div>
                  <div class="flex flex-1 flex-col p-6">
                    <h3 class="font-display text-lg font-semibold">{t!.data.title}</h3>
                    <p class="mt-2 flex-1 text-charcoal-600">{t!.data.summary}</p>
                    <span class="link-arrow mt-4 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.seek.length > 0 && (
      <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24 lg:py-32">
        <img src={seekImg} alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-35" />
        <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/85 to-charcoal-950/40" aria-hidden="true"></div>
        <div class="container-x relative grid items-center gap-12 lg:grid-cols-12">
          <div class="lg:col-span-6" data-reveal>
            <p class="eyebrow">Next step</p>
            <h2 class="mt-4 font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">{d.seekTitle}</h2>
            <div class="rule-gold mt-6"></div>
            {d.seekIntro && <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-200">{d.seekIntro}</p>}
            <a href={FIND_A_DOCTOR_URL} class="btn btn-gold mt-8">See My Provider</a>
          </div>
          <div class="lg:col-span-6" data-reveal style="--d:120ms">
            <ul class="space-y-3">
              {d.seek.map((s) => (
                <li class="flex gap-4 rounded-md border border-white/15 bg-white/[.07] px-6 py-5 text-lg text-cream-50 backdrop-blur-sm"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span><span>{s}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {d.notice && (
      <section class="section pb-0"><div class="container-x"><div class="mx-auto max-w-3xl rounded-md border border-charcoal-900/10 bg-cream-50 p-6 text-charcoal-600" data-reveal><p>{d.notice}</p></div></div></section>
    )}

    {related.length > 0 && (
      <section class="bg-cream-100 section mt-16">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Keep exploring</p>
            <h2 class="h2 mt-4">Related conditions.</h2>
          </div>
          <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li data-reveal>
                <a href={`/conditions/${r!.id}`} class="group block h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white">
                  <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={cimg(r)} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" /></div>
                  <div class="p-6">
                    <h3 class="font-display text-lg font-semibold">{r!.data.title}</h3>
                    <p class="mt-2 text-charcoal-600">{r!.data.summary}</p>
                    <span class="link-arrow mt-4 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <OfficesSection />
    <CtaBand slot="after" title={`Ready to get help with ${d.title.toLowerCase()}?`} />
  </PageLayout>
) : (
  <PageLayout title={d.title} crumb={d.title} crumbs={[{ label: 'Conditions', href: '/conditions' }]} eyebrow="Condition" description={d.summary}>
    <section class="section">
      <div class="container-x">
        <div class="max-w-3xl space-y-4 text-lg leading-relaxed text-charcoal-600"><Content /></div>
        <a href={FIND_A_DOCTOR_URL} class="btn btn-dark mt-10">See My Provider</a>
      </div>
    </section>
    <OfficesSection tint />
  </PageLayout>
)}

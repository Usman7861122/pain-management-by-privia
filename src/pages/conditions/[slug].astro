---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';

export async function getStaticPaths() {
  const items = await getCollection('conditions');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} eyebrow="Condition" description={entry.data.summary}>
  <div class="max-w-3xl"><Content /></div>
  <a href={FIND_A_DOCTOR_URL} class="btn btn-dark mt-10">See My Provider</a>
</PageLayout>

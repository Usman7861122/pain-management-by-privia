---
import { getCollection } from 'astro:content';
import ConditionPage from '@/components/conditions/ConditionPage.astro';
export async function getStaticPaths() {
  const items = await getCollection('conditions');
  const services = await getCollection('services');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: items, services } }));
}
const { entry, all, services } = Astro.props;
---
<ConditionPage entry={entry} all={all} services={services} />

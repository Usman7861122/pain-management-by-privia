---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { nearbyAreasHtml } from '@/data/site';
import { conditionGroups } from '@/data/conditionGroups';

const all = await getCollection('conditions');
const get = (id: string) => all.find((x) => x.id === id)!;
const img = (e: any) => e.data.heroImage || e.data.image || `/images/conditions/${e.id}.jpg`;
const total = all.length;
---

<PageLayout title="Conditions We Treat in Rockville and Frederick, MD." crumb="Conditions" highlight={['Rockville', 'Frederick']} eyebrow="Conditions" lead="Back, neck, nerve and joint pain, and more. Find your condition to learn about symptoms, causes and the care we offer." image="/images/conditions/back-pain.jpg" imageAlt="A person holding their lower back in pain" description="Back, neck, nerve and joint pain conditions we treat in Rockville and Frederick, Maryland." nearby={nearbyAreasHtml}>
  <section class="section overflow-hidden">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Find your condition</p>
        <h2 class="h2 mt-4">The pain we treat, one caring team.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Pain has many causes. Our physicians look for yours, then build a plan around you. Choose a group to start.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {conditionGroups.map((g) => <a href={`#${g.id}`} class="rounded-full border border-charcoal-900/15 bg-cream-50 px-5 py-2.5 font-display text-sm font-semibold text-charcoal-900 transition hover:border-gold-400 hover:bg-white">{g.title}</a>)}
        </div>
      </div>
      <div class="relative lg:col-span-5" data-reveal style="--d:120ms">
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-charcoal-800"><img src="/images/about/exam-senior.jpg" alt="" width="1200" height="900" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  {conditionGroups.map((g, gi) => (
    <section id={g.id} class={(gi % 2 === 0 ? 'bg-cream-100 ' : '') + 'section scroll-mt-28'}>
      <div class="container-x">
        <div class="relative overflow-hidden rounded-md bg-charcoal-950" data-reveal>
          <img src={g.image} alt="" loading="lazy" width="1600" height="600" class="absolute inset-0 h-full w-full object-cover opacity-40" />
          <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/80 to-transparent" aria-hidden="true"></div>
          <div class="on-dark relative flex flex-col gap-6 p-8 sm:p-12 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="eyebrow">Group {String(gi + 1).padStart(2, '0')}</p>
              <h2 class="mt-3 font-display text-[clamp(1.7rem,1.2rem+1.6vw,2.6rem)] font-semibold leading-tight text-cream-50">{g.title}</h2>
              <p class="mt-3 text-lg text-cream-200">{g.text}</p>
            </div>
            <a href={`/conditions/${g.slug}`} class="btn btn-gold shrink-0">View {g.title.toLowerCase()}</a>
          </div>
        </div>
        <ul class={'mt-8 grid gap-5 sm:grid-cols-2 ' + (g.ids.length > 3 ? 'lg:grid-cols-4' : 'lg:grid-cols-3')}>
          {g.ids.map((id, i) => {
            const e = get(id);
            return (
              <li data-reveal style={`--d:${(i % 4) * 70}ms`}>
                <a href={`/conditions/${e.id}`} class="group flex h-full flex-col overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
                  <div class="aspect-[4/3] overflow-hidden bg-charcoal-900"><img src={img(e)} alt="" loading="lazy" width="700" height="525" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.07]" /></div>
                  <div class="flex flex-1 flex-col p-6">
                    <h3 class="font-display text-lg font-semibold">{e.data.title}</h3>
                    <p class="mt-2 flex-1 text-charcoal-600">{e.data.summary}</p>
                    <span class="link-arrow mt-4 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}

  <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24">
    <img src="/images/sections/parallax.jpg" alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/85 to-charcoal-950/40" aria-hidden="true"></div>
    <div class="container-x relative" data-reveal>
      <p class="eyebrow">Not sure what you have?</p>
      <h2 class="mt-4 max-w-2xl font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">Our physicians will find the cause.</h2>
      <div class="rule-gold mt-6"></div>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream-200">You do not need a diagnosis to book. Tell us where it hurts and we will take it from there.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a href="/services" class="btn btn-gold">See our services</a></div>
    </div>
  </section>

  <OfficesSection />
  <CtaBand slot="after" title="Living with pain?" text="You do not have to manage it alone. Choose your provider and schedule online, or call our team." />
</PageLayout>

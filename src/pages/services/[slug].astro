---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CarveOutDisclaimer from '@/components/ui/CarveOutDisclaimer.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';

export async function getStaticPaths() {
  const items = await getCollection('services');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title + (entry.data.carveOut ? ' *' : '')} eyebrow="Service" description={entry.data.summary}>
  <div class="prose max-w-3xl text-charcoal-800"><Content /></div>
  <a href={FIND_A_DOCTOR_URL} class="btn btn-dark mt-10">See My Provider</a>
  {entry.data.carveOut && <CarveOutDisclaimer />}
</PageLayout>

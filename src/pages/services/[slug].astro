---
import { getCollection } from 'astro:content';
import ServicePage from '@/components/services/ServicePage.astro';
export async function getStaticPaths() {
  const items = await getCollection('services');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: items } }));
}
const { entry, all } = Astro.props;
---
<ServicePage entry={entry} all={all} />

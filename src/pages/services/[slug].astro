---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CarveOutDisclaimer from '@/components/ui/CarveOutDisclaimer.astro';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { nearbyAreasHtml } from '@/data/site';

export async function getStaticPaths() {
  const items = await getCollection('services');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: items } }));
}
const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const rich = Boolean(d.lead);
const related = d.related.map((id) => all.find((x) => x.id === id)).filter(Boolean);
const heroTitle = `${d.title}${d.carveOut ? ' *' : ''} in Rockville and Frederick, MD.`;
---

{rich ? (
  <PageLayout title={heroTitle} crumb={d.title} highlight={['Rockville', 'Frederick']} eyebrow="Service" lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} description={d.summary} nearby={nearbyAreasHtml}>
    <section class="section">
      <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7" data-reveal>
          <p class="eyebrow">The basics</p>
          <h2 class="h2 mt-4">What is {d.title.replace(/ Procedure$/, '')}?</h2>
          <div class="rule-gold mt-6"></div>
          <div class="prose-lux mt-6 space-y-4 text-lg leading-relaxed text-charcoal-600 [&_strong]:text-charcoal-950"><Content /></div>
        </div>
        {d.facts.length > 0 && (
          <aside class="lg:col-span-5" data-reveal style="--d:120ms">
            <dl class="relative overflow-hidden rounded-md border border-gold-400/50 bg-gradient-to-br from-white via-cream-50 to-cream-100 p-8 shadow-[0_30px_60px_-40px_rgba(95,76,0,.45)] sm:p-10">
              <span class="pointer-events-none absolute -right-14 -top-14 h-44 w-44 rounded-full bg-cream-200/80 blur-3xl" aria-hidden="true"></span>
              <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent" aria-hidden="true"></span>
              <p class="eyebrow relative mb-6">At a glance</p>
              {d.facts.map((f, i) => (
                <div class={'relative ' + (i > 0 ? 'mt-5 border-t border-charcoal-900/10 pt-5' : '')}>
                  <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-gold-700">{f.k}</dt>
                  <dd class="mt-1.5 font-display text-xl font-semibold leading-snug text-charcoal-950">{f.v}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    </section>

    {d.conditions.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Who it helps</p>
            <h2 class="h2 mt-4">{d.conditionsTitle}</h2>
          </div>
          <ul class="mx-auto mt-12 grid max-w-4xl gap-3 sm:grid-cols-2">
            {d.conditions.map((c, i) => (
              <li data-reveal style={`--d:${(i % 6) * 60}ms`} class="flex items-start gap-3 rounded-md border border-charcoal-900/10 bg-cream-50 px-5 py-4 text-charcoal-800 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-0.5 hover:border-gold-400 hover:bg-white">
                <Check /><span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {d.steps.length > 0 && (
      <section class="section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Step by step</p>
            <h2 class="h2 mt-4">{d.stepsTitle}</h2>
          </div>
          <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {d.steps.map((s, i) => (
              <li data-reveal style={`--d:${(i % 3) * 90}ms`} class="group relative rounded-md border border-charcoal-900/10 bg-cream-50 p-7 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
                <span class="font-display text-3xl font-semibold text-gold-600/80">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 font-display text-lg font-semibold">{s.t}</h3>
                <p class="mt-2 text-charcoal-600">{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {(d.goodFit.length > 0 || d.relief || d.risks.length > 0) && (
      <section class="bg-cream-100 section">
        <div class="container-x grid gap-8 lg:grid-cols-2">
          {d.goodFit.length > 0 && (
            <div class="rounded-md border border-charcoal-900/10 bg-cream-50 p-8 sm:p-10" data-reveal>
              <p class="eyebrow">Candidates</p>
              <h2 class="mt-3 font-display text-2xl font-semibold">{d.fitTitle}</h2>
              <ul class="mt-6 space-y-3 text-charcoal-800">
                {d.goodFit.map((g) => <li class="flex gap-3"><Check /><span>{g}</span></li>)}
              </ul>
              {d.notFit.length > 0 && (
                <>
                  <h3 class="mt-8 font-display text-base font-semibold">{d.notFitTitle}</h3>
                  <ul class="mt-4 space-y-3 text-charcoal-600">
                    {d.notFit.map((g) => <li class="flex gap-3"><Check tone="no" /><span>{g}</span></li>)}
                  </ul>
                </>
              )}
              <p class="mt-6 text-sm text-charcoal-600">Your physician makes the final decision after an exam.</p>
            </div>
          )}
          <div class="space-y-8">
            {d.relief && (
              <div class="rounded-md border border-gold-400/50 bg-gradient-to-br from-white via-cream-50 to-cream-100 p-8 shadow-[0_30px_60px_-40px_rgba(95,76,0,.45)] sm:p-10" data-reveal style="--d:100ms">
                <p class="eyebrow">Recovery</p>
                <h2 class="mt-3 font-display text-2xl font-semibold">{d.reliefTitle}</h2>
                <p class="mt-4 text-lg leading-relaxed text-charcoal-600">{d.relief}</p>
              </div>
            )}
            {d.risks.length > 0 && (
              <div class="rounded-md border border-charcoal-900/10 bg-cream-50 p-8 sm:p-10" data-reveal style="--d:160ms">
                <p class="eyebrow">Safety</p>
                <h2 class="mt-3 font-display text-2xl font-semibold">{d.risksTitle}</h2>
                {d.risksIntro && <p class="mt-3 text-charcoal-600">{d.risksIntro}</p>}
                <ul class="mt-5 space-y-3 text-charcoal-800">
                  {d.risks.map((r) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span><span>{r}</span></li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {(d.alternatives.length > 0 || d.notice) && (
      <section class="section">
        <div class="container-x">
          <div class="mx-auto max-w-3xl space-y-8">
            {d.alternatives.length > 0 && (
              <div data-reveal>
                <p class="eyebrow">Other options</p>
                <h2 class="mt-3 font-display text-2xl font-semibold">Other ways to treat the pain</h2>
                <ul class="mt-5 flex flex-wrap gap-2.5">
                  {d.alternatives.map((a) => <li class="rounded-md border border-charcoal-900/15 bg-cream-50 px-4 py-2 text-sm text-charcoal-800">{a}</li>)}
                </ul>
              </div>
            )}
            {d.notice && (
              <div class="rounded-md border border-charcoal-900/10 bg-cream-50 p-6 text-charcoal-600" data-reveal><p>{d.notice}</p></div>
            )}
          </div>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="bg-cream-100 section">
        <div class="container-x">
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="eyebrow">Keep exploring</p>
            <h2 class="h2 mt-4">Related treatments.</h2>
          </div>
          <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li data-reveal>
                <a href={`/services/${r!.id}`} class="group block h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white">
                  {r!.data.heroImage && <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={r!.data.heroImage} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" /></div>}
                  <div class="p-6">
                    <h3 class="font-display text-lg font-semibold">{r!.data.title}</h3>
                    <p class="mt-2 text-charcoal-600">{r!.data.summary}</p>
                    <span class="link-arrow mt-4 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <OfficesSection />
    {d.carveOut && <div class="container-x"><CarveOutDisclaimer /></div>}
    <CtaBand slot="after" title={`Ready to talk about ${d.title.replace(/ Procedure$/, '')}?`} />
  </PageLayout>
) : (
  <PageLayout title={heroTitle} crumb={d.title} highlight={['Rockville', 'Frederick']} eyebrow="Service" description={d.summary} nearby={nearbyAreasHtml}>
    <section class="section">
      <div class="container-x">
        <div class="max-w-3xl space-y-4 text-lg leading-relaxed text-charcoal-600"><Content /></div>
        <a href={FIND_A_DOCTOR_URL} class="btn btn-dark mt-10">See My Provider</a>
        {d.carveOut && <CarveOutDisclaimer />}
      </div>
    </section>
    <OfficesSection tint />
  </PageLayout>
)}

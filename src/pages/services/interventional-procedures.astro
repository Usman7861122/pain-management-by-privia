---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { nearbyAreasHtml } from '@/data/site';

const all = await getCollection('services');
const byId = (id: string) => all.find((x) => x.id === id)!;

const groups = [
  { eyebrow: 'Calm inflamed nerves', title: 'Injections that ease nerve and joint pain', text: 'Targeted medicine, placed exactly where the pain starts.', ids: ['epidural-steroid-injections', 'nerve-blocks', 'cortisone-injections'] },
  { eyebrow: 'Quiet pain signals', title: 'Treatments that stop pain from reaching the brain', text: 'Gentle heat that quiets the nerves carrying long-term pain.', ids: ['radiofrequency-ablation', 'intracept-procedure'] },
  { eyebrow: 'Treat the spine itself', title: 'Procedures that help the bones and the spinal canal', text: 'Minimally invasive options for fractures and narrowing of the spine.', ids: ['kyphoplasty', 'mild-procedure'] },
];
const overview = byId('interventional-pain-management');
---

<PageLayout title="Interventional Procedures in Rockville and Frederick, MD." crumb="Interventional Procedures" highlight={['Rockville', 'Frederick']} eyebrow="Services" lead="Precise, image-guided treatments that go to the source of your pain. Explore each procedure below and see which one may fit you." image="/images/services/interventional-pain-management.jpg" imageAlt="A physician performing an image-guided pain procedure" description="All interventional pain procedures at Pain Management Specialists in Rockville and Frederick, Maryland." nearby={nearbyAreasHtml}>
  <section class="section">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Start here</p>
        <h2 class="h2 mt-4">What are interventional procedures?</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">They are small, precise treatments that find and treat the source of pain, often with live X-ray or ultrasound to guide the way. Most are done as outpatient visits, so you go home the same day.</p>
        <p class="lead mt-4">Our board certified physicians use them as one part of a wider plan that can also include therapy, education and medicine. Not every procedure is right for every person, and your doctor will explain your options.</p>
        <a href="/interventional-pain-management" class="link-arrow mt-6 text-gold-700">Read the full overview</a>
      </div>
      <div class="lg:col-span-5" data-reveal style="--d:120ms">
        <div class="relative">
          <span class="absolute inset-0 translate-x-3 translate-y-3 rounded-md border border-gold-400/50" aria-hidden="true"></span>
          <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-cream-100 shadow-[0_24px_50px_-30px_rgba(27,28,31,0.5)]">
            <img src="/images/interventional/spine-injection.jpg" alt="A doctor preparing a back injection for a patient" width="1200" height="900" loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {groups.map((g, gi) => (
    <section class={gi % 2 === 0 ? 'bg-cream-100 section' : 'section'}>
      <div class="container-x">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">{g.eyebrow}</p>
          <h2 class="h2 mt-4">{g.title}</h2>
          <p class="lead mt-3">{g.text}</p>
        </div>
        <ul class={`mt-10 grid gap-5 sm:grid-cols-2 ${g.ids.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2'}`}>
          {g.ids.map((id, i) => {
            const e = byId(id);
            return (
              <li data-reveal style={`--d:${i * 90}ms`}>
                <a href={`/services/${e.id}`} class="group block h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
                  <div class="aspect-[16/10] overflow-hidden bg-charcoal-900">
                    <img src={e.data.heroImage} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" />
                  </div>
                  <div class="p-7">
                    <h3 class="font-display text-xl font-semibold">{e.data.title}</h3>
                    <p class="mt-3 text-charcoal-600">{e.data.summary}</p>
                    <span class="link-arrow mt-5 text-gold-700">Learn more</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}

  <OfficesSection tint={groups.length % 2 === 1 ? false : true} />
  <CtaBand slot="after" title="Not sure which procedure is right for you?" text="Our physicians will examine you and explain your options. Choose your provider and schedule online, or call our team." />
</PageLayout>

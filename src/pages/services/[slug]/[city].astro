---
import { getCollection } from 'astro:content';
import ServicePage from '@/components/services/ServicePage.astro';
import InterventionalPage from '@/components/services/InterventionalPage.astro';
import { CITY_SLUGS } from '@/data/cityServices';
export async function getStaticPaths() {
  const items = await getCollection('services');
  return items
    .flatMap((entry) => CITY_SLUGS.map((city) => ({ params: { slug: entry.id, city }, props: { entry, all: items, city } })));
}
const { entry, all, city } = Astro.props;
---
{entry.id === 'interventional-pain-management' ? <InterventionalPage city={city} /> : <ServicePage entry={entry} all={all} city={city} />}

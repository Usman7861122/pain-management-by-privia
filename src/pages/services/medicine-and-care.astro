---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import OfficesSection from '@/components/ui/OfficesSection.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import { nearbyAreasHtml } from '@/data/site';

const all = await getCollection('services');
const byId = (id: string) => all.find((x) => x.id === id)!;
const ids = ['pain-management', 'pain-medicine'];
---

<PageLayout title="Medicine & Care in Rockville and Frederick, MD." crumb="Medicine & Care" highlight={['Rockville', 'Frederick']} eyebrow="Services" lead="Whole-person care plans, with and without medication, built around your history, your goals and your daily life." image="/images/about/exam-senior.jpg" imageAlt="A clinician examining a patient's lower back" description="Pain management and pain medicine at Pain Management Specialists in Rockville and Frederick, Maryland." nearby={nearbyAreasHtml}>
  <section class="section overflow-hidden">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="relative lg:col-span-5" data-reveal>
        <div class="absolute -bottom-4 -left-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800"><img src="/images/tunnel/doctor-patient.jpg" alt="" width="800" height="1000" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:100ms">
        <p class="eyebrow">Start here</p>
        <h2 class="h2 mt-4">Care that treats you, not just the pain.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Good pain care starts with listening. We look for the cause, then build a plan that can include medicine, procedures, exercise and healthy habits.</p>
        <ul class="mt-8 space-y-3 text-lg text-charcoal-800">
          <li class="flex gap-3"><Check /><span>Non-opioid options first</span></li>
          <li class="flex gap-3"><Check /><span>A plan made for your goals</span></li>
          <li class="flex gap-3"><Check /><span>Two board-certified interventional pain physicians</span></li>
          <li class="flex gap-3"><Check /><span>Two offices, in Rockville and Frederick</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Our care</p>
        <h2 class="h2 mt-4">Two ways we look after you.</h2>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {ids.map((id, i) => {
          const e = byId(id);
          return (
            <li data-reveal style={`--d:${i * 100}ms`}>
              <a href={`/services/${e.id}`} class="group block h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
                <div class="aspect-[16/10] overflow-hidden bg-charcoal-900"><img src={e.data.heroImage} alt="" loading="lazy" width="900" height="560" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]" /></div>
                <div class="p-8">
                  <h3 class="font-display text-2xl font-semibold">{e.data.title}</h3>
                  <p class="mt-3 text-lg text-charcoal-600">{e.data.summary}</p>
                  <span class="link-arrow mt-5 text-gold-700">Learn more</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24">
    <img src="/images/sections/parallax.jpg" alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950 via-charcoal-950/85 to-charcoal-950/40" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2 class="mt-4 font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">Opioids only when clearly needed.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream-200">We follow CDC guidelines and try safer options first. See how we help people find relief without opioids.</p>
        <a href="/about/treatment-without-opioids" class="btn btn-gold mt-8">Treatment without opioids</a>
      </div>
    </div>
  </section>

  <OfficesSection />
  <CtaBand slot="after" title="Ready to build your care plan?" text="Choose your provider and schedule online, or call our team." />
</PageLayout>

---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSubnav from '@/components/ui/AboutSubnav.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { site, mapsUrl } from '@/data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const conditions = (await getCollection('conditions')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  { n: '01', t: 'Find the cause', d: 'We listen first. Then we look for the source of your pain, so treatment is aimed at the right place.' },
  { n: '02', t: 'Ease the pain', d: 'We lower how strong your pain feels, and the stress and limits it puts on your day.' },
  { n: '03', t: 'Restore your life', d: 'We help you move, work and rest with more comfort, and we check in over time.' },
];
const tools = ['Medicines', 'Physical therapy', 'Chiropractic care', 'Electrical stimulation', 'Injections', 'Surgery referral', 'Biofeedback', 'Acupuncture', 'Implanted devices'];
---

<PageLayout title="A different kind of pain doctor." eyebrow="What we do" lead="We look for the cause of your pain, then build a clear plan to ease it and help you live better." image="/images/about/examine-back.jpg" imageAlt="A doctor examining a patient's back in a bright clinic" description="How Pain Management Specialists treats acute and chronic pain.">
  <AboutSubnav />

  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Two kinds of pain</p>
        <h2 class="h2 mt-4">Whatever type of pain you have, we can help.</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <div data-reveal class="rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 hover:-translate-y-1 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
          <p class="eyebrow">Acute pain</p>
          <h3 class="mt-3 font-display text-xl font-semibold">Pain that is new</h3>
          <p class="mt-3 text-charcoal-600">It often follows surgery, an injury or a serious illness. It is usually short term, and the right care helps you heal with less discomfort.</p>
        </div>
        <div data-reveal style="--d:100ms" class="rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 hover:-translate-y-1 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
          <p class="eyebrow">Chronic pain</p>
          <h3 class="mt-3 font-display text-xl font-semibold">Pain that lasts</h3>
          <p class="mt-3 text-charcoal-600">It can come from arthritis, back problems, headaches, cancer or nerve damage. It needs a steady plan that is checked and adjusted over time.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark bg-charcoal-950 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Our approach</p>
        <h2 class="h2 mt-4">Three steps, explained clearly.</h2>
      </div>
      <ol class="mt-14 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li data-reveal style={`--d:${i * 100}ms`} class="group relative overflow-hidden rounded-md border border-white/10 bg-white/[0.04] p-8 transition duration-500 hover:-translate-y-1.5 hover:border-gold-300/60 hover:bg-white/[0.07]">
            <span class="font-display text-5xl font-semibold text-white/15 transition-colors duration-500 group-hover:text-gold-300/60">{s.n}</span>
            <h3 class="mt-4 font-display text-xl font-semibold text-cream-50">{s.t}</h3>
            <p class="mt-3 text-cream-200">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5" data-reveal>
        <div class="relative">
          <div class="absolute -bottom-4 -right-4 h-3/4 w-3/4 rounded-md bg-cream-200" aria-hidden="true"></div>
          <div class="relative aspect-[4/3] overflow-hidden rounded-md">
            <img src="/images/about/exam-senior.jpg" alt="A doctor gently examining a patient's upper back" width="1200" height="800" loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:120ms">
        <p class="eyebrow">Your plan</p>
        <h2 class="h2 mt-4">Many tools. One plan made for you.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Pain care can use many tools. Your plan may include one or several of these, with our team or with trusted partners. We explain each choice and keep the cost sensible.</p>
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {tools.map((t) => <li class="rounded-md border border-charcoal-900/15 bg-cream-50 px-4 py-2 text-sm text-charcoal-800 transition duration-300 hover:border-gold-600 hover:bg-cream-100">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">Services</p>
        <h2 class="h2 mt-4">What we offer</h2>
        <ul class="mt-8 grid gap-1 sm:grid-cols-2">
          {services.map((s) => <li><a href={`/services/${s.id}`} class="dd-link">{s.data.title}</a></li>)}
        </ul>
      </div>
      <div data-reveal style="--d:100ms">
        <p class="eyebrow">Conditions</p>
        <h2 class="h2 mt-4">What we treat</h2>
        <ul class="mt-8 grid gap-1 sm:grid-cols-2">
          {conditions.map((c) => <li><a href={`/conditions/${c.id}`} class="dd-link">{c.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Our offices</p>
        <h2 class="h2 mt-4">Two places to find us in Maryland.</h2>
      </div>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-5 md:grid-cols-2">
        {site.locations.map((l) => (
          <li data-reveal class="rounded-md border border-charcoal-900/10 bg-cream-50 p-7">
            <h3 class="font-display text-lg font-semibold">{l.name}</h3>
            <p class="mt-2 text-charcoal-600">{l.street}, {l.city}, {l.state} {l.zip}</p>
            <a href={mapsUrl(l)} class="link-arrow mt-4 text-gold-700">Get directions</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand slot="after" />
</PageLayout>

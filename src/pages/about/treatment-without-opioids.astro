---
import PageLayout from '@/layouts/PageLayout.astro';
import AboutSubnav from '@/components/ui/AboutSubnav.astro';
import CtaBand from '@/components/ui/CtaBand.astro';

const pillars = [
  { t: 'Restore movement', d: 'Physical and functional care that helps your body get stronger and do more each week.', icon: '<circle cx="12" cy="5" r="2"/><path d="M12 8v6l-3 6M12 14l3 6M7 11l5-3 5 3"/>' },
  { t: 'Support the mind', d: 'Behavioral therapies that help you cope with pain, sleep better and feel more in control.', icon: '<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>' },
  { t: 'Build healthy habits', d: 'Simple changes to food and daily routines that help you take part in your own recovery.', icon: '<path d="M12 21c-4 0-7-3-7-7 0-5 7-11 7-11s7 6 7 11c0 4-3 7-7 7z"/><path d="M12 21v-8"/>' },
];
---

<PageLayout title="Treatment without opioids." eyebrow="Our approach" lead="For most people with long-term pain, we focus on safer ways to feel better and move more, not on opioid medicine." image="/images/about/movement.jpg" imageAlt="A smiling physical therapist helping an older woman with an exercise" description="Why Pain Management Specialists usually does not prescribe opioids for chronic pain, and what we offer instead.">
  <AboutSubnav />

  <section class="section">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">Why we changed</p>
        <h2 class="h2 mt-4">What the evidence has shown us.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">Over the past twenty years, opioid medicines were widely used for long-term pain. Over the same time, addiction, overdose and death linked to prescription drugs went up, and pain-related disability kept growing.</p>
        <p class="lead mt-4">Large studies suggest that long-term opioid use does not help most people, and it can cause harm. For many patients, lowering or stopping opioids does not make pain worse. It often eases other symptoms and can improve quality of life.</p>
      </div>
      <div class="lg:col-span-6" data-reveal style="--d:120ms">
        <div class="relative overflow-hidden rounded-md border border-gold-400/50 bg-gradient-to-br from-white via-cream-50 to-cream-100 p-8 shadow-[0_30px_60px_-40px_rgba(95,76,0,.45)] sm:p-10">
          <p class="eyebrow">Our position</p>
          <p class="mt-4 font-display text-2xl font-semibold leading-snug text-charcoal-950">We no longer believe most patients can use opioids safely and well for chronic pain. So we usually do not prescribe them.</p>
          <p class="mt-4 text-charcoal-600">Instead, we put our time into care that helps you function better and stay in control of your health.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">What we do instead</p>
        <h2 class="h2 mt-4">Three ways we help you heal.</h2>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <li data-reveal style={`--d:${i * 100}ms`} class="group rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-cream-100 text-gold-700 transition duration-500 group-hover:bg-charcoal-950 group-hover:text-gold-300">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon}></svg>
            </span>
            <h3 class="mt-6 font-display text-xl font-semibold">{p.t}</h3>
            <p class="mt-3 text-charcoal-600">{p.d}</p>
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-charcoal-600" data-reveal>We also plan to bring even more behavioral health and rehabilitation services into our care.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-3xl rounded-md border border-charcoal-900/10 bg-cream-50 p-8 sm:p-10" data-reveal>
        <p class="eyebrow">Prescription refills</p>
        <h2 class="mt-3 font-display text-2xl font-semibold">Please plan your refills with your visits.</h2>
        <ul class="mt-5 space-y-3 text-charcoal-600">
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>Refills need an appointment.</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>We try to prescribe enough medicine to last until your next visit.</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>We do not prescribe narcotics without an appointment.</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand slot="after" title="Let’s talk about a plan that works for you." />
</PageLayout>

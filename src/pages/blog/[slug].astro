---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('blog');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} eyebrow="Blog" description={entry.data.description}>
  <div class="max-w-3xl space-y-4"><Content /></div>
</PageLayout>

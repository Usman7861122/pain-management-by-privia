---
import PageLayout from '@/layouts/PageLayout.astro';
import FormsList from '@/components/ui/FormsList.astro';
import CtaBand from '@/components/ui/CtaBand.astro';

const helpers = [
  { t: 'Become a patient', d: 'New here? Follow three simple steps.', href: '/become-a-patient' },
  { t: 'Returning patients', d: 'Tips for your next visit.', href: '/patient-resources/returning-patients' },
  { t: 'Virtual visits', d: 'Meet with your provider by video.', href: '/virtual-visits' },
  { t: 'Insurance', d: 'How to check your coverage.', href: '/insurance' },
  { t: 'FAQ', d: 'Answers to common questions.', href: '/patient-resources/faq' },
];
---

<PageLayout title="Patient forms and resources." crumb="Resources" highlight={['forms']} eyebrow="Resources" lead="Download the forms you need and find answers about visits, coverage and care." image="/images/about/exam-senior.jpg" imageAlt="A clinician speaking with a patient during an exam" description="Patient forms and office policies, plus helpful guides for new and returning patients of Pain Management Specialists.">
  <section class="section">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <div data-reveal>
          <p class="eyebrow">Forms and policies</p>
          <h2 class="h2 mt-4">Patient forms and office policies</h2>
          <div class="rule-gold mt-6"></div>
          <p class="lead mt-6 max-w-2xl">Download the forms below. English and Spanish versions are provided when available.</p>
        </div>
        <div class="mt-10" data-reveal><FormsList /></div>
      </div>
      <div class="relative hidden lg:col-span-4 lg:block" data-reveal style="--d:120ms">
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
        <div class="relative aspect-[3/5] overflow-hidden rounded-md bg-charcoal-800"><img src="/images/tunnel/diagnosis.jpg" alt="" width="600" height="1000" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">More help</p>
        <h2 class="h2 mt-4">Where would you like to go next?</h2>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {helpers.map((h, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <a href={h.href} class="group block h-full rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
              <h3 class="font-display text-xl font-semibold">{h.t}</h3>
              <p class="mt-3 text-charcoal-600">{h.d}</p>
              <span class="link-arrow mt-4 text-gold-700">Learn more</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand slot="after" title="Need a hand with your forms?" text="Our team is happy to help. Call us or choose your provider to schedule." />
</PageLayout>

---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import ConsentEmbed from '@/components/ui/ConsentEmbed.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import { site, mapsUrl } from '@/data/site';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { conditionGroups } from '@/data/conditionGroups';
import { locationDetails, serviceGroups, firstVisit } from '@/data/locationDetails';

export function getStaticPaths() {
  return site.locations.map((l) => ({ params: { slug: l.slug }, props: { slug: l.slug } }));
}

const { slug } = Astro.props;
const loc = site.locations.find((l) => l.slug === slug)!;
const other = site.locations.find((l) => l.slug !== slug)!;
const d = locationDetails[slug];

const services = await getCollection('services');
const conditions = await getCollection('conditions');
const doctors = (await getCollection('doctors')).sort((a, b) => a.data.order - b.data.order);
const svc = (id: string) => services.find((x) => x.id === id)!;
const cond = (id: string) => conditions.find((x) => x.id === id)!;

const address = `${loc.street}, ${loc.city}, ${loc.state} ${loc.zip}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: `${site.name} (${loc.city})`,
  medicalSpecialty: 'PainMedicine',
  telephone: loc.phone.tel,
  address: { '@type': 'PostalAddress', streetAddress: loc.street, addressLocality: loc.city, addressRegion: loc.state, postalCode: loc.zip, addressCountry: 'US' },
  areaServed: d.serves,
};
---

<PageLayout title={`Pain Management in ${loc.city}, MD.`} crumb={loc.city} highlight={[loc.city]} eyebrow="Our location" lead={d.lead} image={d.heroImage} imageAlt={d.heroAlt} description={d.description} nearby={d.nearby}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>

  <!-- Details -->
  <section class="section overflow-hidden">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Visit us in {loc.city}</p>
        <h2 class="h2 mt-4">Expert pain care, close to home.</h2>
        <div class="rule-gold mt-6"></div>
        <p class="lead mt-6">{d.intro}</p>
        <ul class="mt-8 space-y-3 text-lg text-charcoal-800">
          <li class="flex gap-3"><Check /><span>Two board-certified interventional pain physicians</span></li>
          <li class="flex gap-3"><Check /><span>Image-guided procedures and non-opioid options first</span></li>
          <li class="flex gap-3"><Check /><span>Virtual visits for many follow-up appointments</span></li>
          <li class="flex gap-3"><Check /><span>Serving {d.serves.join(', ')}</span></li>
        </ul>
      </div>

      <aside class="lg:col-span-5" data-reveal style="--d:120ms" aria-label={`${loc.city} office details`}>
        <div class="relative">
          <div class="absolute -bottom-4 -right-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
          <div class="relative rounded-md bg-charcoal-950 p-8 text-cream-50 shadow-[0_28px_60px_-28px_rgba(0,0,0,.6)] sm:p-10">
            <p class="eyebrow !text-gold-300">Office details</p>
            <h3 class="mt-3 font-display text-2xl font-semibold text-cream-50">{loc.city}, {loc.state}</h3>
            <dl class="mt-6 space-y-5 text-cream-200">
              <div class="flex gap-4">
                <svg class="mt-1 shrink-0 text-gold-400" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <div><dt class="sr-only">Address</dt><dd><address class="not-italic">{loc.street}<br />{loc.city}, {loc.state} {loc.zip}</address></dd></div>
              </div>
              <div class="flex gap-4">
                <svg class="mt-1 shrink-0 text-gold-400" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
                <div><dt class="sr-only">Phone</dt><dd><a href={`tel:${loc.phone.tel}`} class="inline-flex min-h-11 items-center font-semibold text-cream-50 underline decoration-gold-400 underline-offset-4">{loc.phone.display}</a></dd></div>
              </div>
              <!-- VERIFY with practice: office hours are not on the old site yet, so none are shown. -->
              <div class="flex gap-4">
                <svg class="mt-1 shrink-0 text-gold-400" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <div><dt class="sr-only">Hours</dt><dd>Please call the office for current hours.</dd></div>
              </div>
            </dl>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href={FIND_A_DOCTOR_URL} class="btn btn-gold">Book in {loc.city}</a>
              <a href={mapsUrl(loc)} class="link-arrow !text-gold-300" target="_blank" rel="noopener">Get directions</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Find us</p>
        <h2 class="h2 mt-4">Getting to our {loc.city} office.</h2>
        <p class="lead mt-4">{address}</p>
      </div>
      <div class="relative mt-10" data-reveal>
        <div class="absolute -bottom-4 -left-4 h-full w-full rounded-md border border-gold-400/50" aria-hidden="true"></div>
        <div class="relative h-72 overflow-hidden sm:h-auto sm:aspect-[16/9] rounded-md bg-cream-200 shadow-[0_24px_50px_-34px_rgba(27,28,31,0.5)]">
          <ConsentEmbed src={mapSrc} title={`Map of the ${loc.city} office, ${address}`} class="absolute inset-0 h-full w-full" linkHref={mapsUrl(loc)} linkLabel="Open in Google Maps" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Treatments in {loc.city}</p>
        <h2 class="h2 mt-4">Services offered at our {loc.city} office.</h2>
        <div class="rule-gold mx-auto mt-6"></div>
        <p class="lead mt-6">Both offices offer the full range of treatments. Pick a service to learn how it works.</p>
      </div>
      <div class="mt-14 grid gap-8 lg:grid-cols-3">
        {serviceGroups.map((g, i) => (
          <div data-reveal style={`--d:${i * 100}ms`} class="rounded-md border border-charcoal-900/10 bg-cream-50 p-8">
            <h3 class="font-display text-xl font-semibold"><a href={g.href} class="transition hover:text-gold-700">{g.title}</a></h3>
            <div class="rule-gold mt-4"></div>
            <ul class="mt-5 space-y-1">
              {g.items.map((id) => (
                <li><a href={`/services/${id}`} class="group flex min-h-11 items-center justify-between gap-3 border-b border-charcoal-900/10 text-charcoal-800 transition hover:border-gold-400 hover:text-charcoal-950"><span>{svc(id).data.title}</span><svg class="shrink-0 text-gold-600 transition-transform duration-300 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"/></svg></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center" data-reveal><a href="/services" class="link-arrow text-gold-700">See all services</a></p>
    </div>
  </section>

  <!-- Conditions -->
  <section class="on-dark relative overflow-hidden bg-charcoal-950 py-24" id="conditions">
    <img src="/images/sections/parallax.jpg" alt="" loading="lazy" width="2000" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-25" />
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal-950/90 via-charcoal-950/80 to-charcoal-950" aria-hidden="true"></div>
    <div class="container-x relative">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Conditions we treat</p>
        <h2 class="mt-4 font-display text-[clamp(1.9rem,1.3rem+2vw,3rem)] font-semibold leading-tight text-cream-50">Pain we treat in {loc.city}.</h2>
        <div class="rule-gold mx-auto mt-6"></div>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {conditionGroups.map((g, i) => (
          <div data-reveal style={`--d:${i * 100}ms`} class="rounded-md border border-white/15 bg-white/5 p-8 backdrop-blur-sm">
            <h3 class="font-display text-xl font-semibold text-cream-50"><a href={`/conditions/${g.slug}`} class="transition hover:text-gold-300">{g.title}</a></h3>
            <p class="mt-2 text-cream-200">{g.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {g.ids.map((id) => (
                <li><a href={`/conditions/${id}`} class="inline-flex min-h-11 items-center rounded-full border border-white/20 px-4 text-sm text-cream-100 transition hover:border-gold-400 hover:bg-gold-400 hover:text-charcoal-950">{cond(id).data.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center" data-reveal><a href="/conditions" class="link-arrow !text-gold-300">See all conditions</a></p>
    </div>
  </section>

  <!-- First visit -->
  <section class="section overflow-hidden">
    <div class="container-x grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Your first visit</p>
        <h2 class="h2 mt-4">What to expect in {loc.city}.</h2>
        <div class="rule-gold mt-6"></div>
        <ol class="relative mt-10 space-y-8 border-l-2 border-gold-400/60 pl-8">
          {firstVisit.map((s, i) => (
            <li class="relative">
              <span class="absolute -left-[2.9rem] flex h-9 w-9 items-center justify-center rounded-full bg-charcoal-950 font-display text-sm font-semibold text-gold-300">{i + 1}</span>
              <h3 class="font-display text-xl font-semibold">{s.t}</h3>
              <p class="mt-2 text-lg text-charcoal-600">{s.d}</p>
            </li>
          ))}
        </ol>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/become-a-patient" class="btn btn-dark">Become a patient</a>
          <a href="/virtual-visits" class="btn btn-ghost !text-charcoal-950">Virtual visits</a>
        </div>
      </div>
      <div class="relative lg:col-span-5" data-reveal style="--d:120ms">
        <div class="absolute -bottom-4 -left-4 h-3/4 w-3/4 rounded-md bg-cream-200" aria-hidden="true"></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-charcoal-800"><img src={d.galleryImage} alt="Our care team" width="900" height="1125" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <!-- Physicians -->
  <section class="bg-cream-100 section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Your physicians</p>
        <h2 class="h2 mt-4">Meet the doctors who see you.</h2>
        <p class="lead mt-4">Our board-certified physicians care for patients in both offices.</p>
      </div>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        {doctors.map((doc, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <a href={`/doctors/${doc.id}`} class="group flex h-full items-center gap-6 rounded-md border border-charcoal-900/10 bg-cream-50 p-5 transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white hover:shadow-[0_22px_40px_-24px_rgba(95,76,0,.45)]">
              <img src={doc.data.photo ?? `/images/providers/${doc.id}.jpg`} alt="" width="120" height="150" loading="lazy" class="h-28 w-24 shrink-0 rounded object-cover object-top" />
              <div>
                <h3 class="font-display text-xl font-semibold">{doc.data.name}</h3>
                <p class="mt-1 text-charcoal-600">{doc.data.title}</p>
                <span class="link-arrow mt-3 text-gold-700">View profile</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Other office -->
  <section class="section">
    <div class="container-x">
      <div class="grid items-center gap-8 overflow-hidden rounded-md border border-charcoal-900/10 bg-cream-50 lg:grid-cols-12" data-reveal>
        <div class="aspect-[16/9] lg:col-span-5 lg:aspect-auto lg:h-full"><img src={locationDetails[other.slug].heroImage} alt={`${other.city}, Maryland`} width="1000" height="560" loading="lazy" class="h-full w-full object-cover" /></div>
        <div class="p-8 lg:col-span-7 lg:p-10">
          <p class="eyebrow">Also near you</p>
          <h2 class="mt-3 font-display text-2xl font-semibold">Our {other.city} office</h2>
          <address class="mt-3 not-italic text-charcoal-800">{other.street}, {other.city}, {other.state} {other.zip}</address>
          <p class="mt-1"><a href={`tel:${other.phone.tel}`} class="font-semibold underline decoration-gold-400 underline-offset-4">{other.phone.display}</a></p>
          <a href={`/locations/${other.slug}`} class="link-arrow mt-5 text-gold-700">See the {other.city} page</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand slot="after" title={`Ready to be seen in ${loc.city}?`} text="Choose your provider and schedule online, or call our team. We are happy to help." />
</PageLayout>

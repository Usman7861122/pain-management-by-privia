---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Check from '@/components/ui/Check.astro';
import { site, mapsUrl, nearbyAreasHtml } from '@/data/site';
import { FIND_A_DOCTOR_URL } from '@/data/privia';
import { locationDetails } from '@/data/locationDetails';

const both = [
  { t: 'The same physicians', d: 'Our board-certified physicians care for patients in both offices.' },
  { t: 'The full range of care', d: 'Injections, nerve treatments, advanced implants and medicine plans.' },
  { t: 'Virtual visits too', d: 'Many follow-up visits can be done safely from home.' },
];
---

<PageLayout title="Our Locations in Rockville and Frederick, MD." crumb="Locations" highlight={['Rockville', 'Frederick']} eyebrow="Where we are" lead="Two offices, one team. Choose the office that is easiest for you to reach." image="/images/locations/rockville.jpg" imageAlt="Rockville, Maryland" description="Pain Management Specialists has offices in Rockville and Frederick, Maryland. See addresses, phone numbers, directions, services and conditions treated." nearby={nearbyAreasHtml}>
  <section class="section overflow-hidden">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Choose your office</p>
        <h2 class="h2 mt-4">Pain care close to home.</h2>
        <div class="rule-gold mx-auto mt-6"></div>
      </div>
      <ul class="mt-14 grid gap-8 lg:grid-cols-2">
        {site.locations.map((l, i) => {
          const d = locationDetails[l.slug];
          return (
            <li data-reveal style={`--d:${i * 120}ms`}>
              <article class="group h-full overflow-hidden rounded-md border border-charcoal-900/10 bg-white shadow-[0_24px_50px_-34px_rgba(27,28,31,0.5)] transition duration-500 ease-[var(--ease-lux)] hover:-translate-y-1.5 hover:border-gold-400">
                <a href={`/locations/${l.slug}`} class="block aspect-[16/9] overflow-hidden bg-cream-100" tabindex="-1" aria-hidden="true">
                  <img src={d.heroImage} alt="" width="1200" height="675" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-[1.05]" />
                </a>
                <div class="p-8">
                  <p class="eyebrow">{d.county}</p>
                  <h3 class="mt-2 font-display text-2xl font-semibold"><a href={`/locations/${l.slug}`} class="transition hover:text-gold-700">{l.city}, {l.state}</a></h3>
                  <address class="mt-4 not-italic text-charcoal-800">{l.street}<br />{l.city}, {l.state} {l.zip}</address>
                  <p class="mt-2 text-charcoal-600">Appointments: <a href={`tel:${l.phone.tel}`} class="font-semibold text-charcoal-950 underline decoration-gold-400 underline-offset-4">{l.phone.display}</a></p>
                  <p class="mt-4 text-charcoal-600">Serving {d.serves.join(', ')}.</p>
                  <div class="mt-6 flex flex-wrap items-center gap-3">
                    <a href={`/locations/${l.slug}`} class="btn btn-dark !min-h-10 !px-5">Office details</a>
                    <a href={FIND_A_DOCTOR_URL} class="btn btn-ghost !min-h-10 !px-5 !text-charcoal-950">Book in {l.city}</a>
                    <a href={mapsUrl(l)} class="link-arrow text-gold-700" target="_blank" rel="noopener">Directions</a>
                  </div>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">At both offices</p>
        <h2 class="h2 mt-4">The same care, wherever you go.</h2>
        <div class="rule-gold mt-6"></div>
        <ul class="mt-8 space-y-5">
          {both.map((b) => (
            <li class="flex gap-4"><Check /><div><p class="font-display text-lg font-semibold">{b.t}</p><p class="text-charcoal-600">{b.d}</p></div></li>
          ))}
        </ul>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-6" data-reveal style="--d:120ms">
        <a href="/services" class="group rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white">
          <p class="eyebrow">What we offer</p>
          <p class="mt-3 font-display text-2xl font-semibold">Services</p>
          <p class="mt-2 text-charcoal-600">14 treatments, from injections to implants.</p>
          <span class="link-arrow mt-5 text-gold-700">See services</span>
        </a>
        <a href="/conditions" class="group rounded-md border border-charcoal-900/10 bg-cream-50 p-8 transition duration-500 hover:-translate-y-1.5 hover:border-gold-400 hover:bg-white">
          <p class="eyebrow">What we treat</p>
          <p class="mt-3 font-display text-2xl font-semibold">Conditions</p>
          <p class="mt-2 text-charcoal-600">Spine, nerve, joint and injury pain.</p>
          <span class="link-arrow mt-5 text-gold-700">See conditions</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand slot="after" title="Ready to choose your office?" text="Choose your provider and schedule online, or call the office nearest you." />
</PageLayout>
